<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-scripts' -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name | handle }}--{{ template.suffix | handle }}{% endif %}{% if settings.animations_enabled %} has-animations{% endif %}">
    <a class="skip-link visually-hidden-focusable" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    {% sections 'overlay-group' %}

    <div class="visually-hidden" aria-live="polite" role="status" data-live-region></div>
  </body>
</html>
