{% doc %}
  Inline SVG illustrations for the "How it is made" steps, drawn with the
  theme's colour tokens. Decorative (aria-hidden).

  @param {string} name - mark | master | print | edition
  @param {string} [caption] - Text for the edition stamp, e.g. "No. 001 – 120"
{% enddoc %}
<svg class="process-illustration" viewBox="0 0 300 200" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'mark' -%}
      <rect x="60" y="30" width="180" height="140" fill="var(--color-white)" stroke="var(--color-ink)" stroke-width="2"/>
      <circle cx="130" cy="90" r="34" fill="var(--color-blue)"/>
      <rect x="150" y="80" width="64" height="64" fill="var(--color-ink)" style="mix-blend-mode: multiply"/>
      <path d="M60 30 l-14 -14 M240 30 l14 -14 M60 170 l-14 14 M240 170 l14 14" stroke="var(--color-ink)" stroke-width="2"/>
    {%- when 'master' -%}
      <rect x="70" y="40" width="160" height="120" fill="var(--color-ink)"/>
      <circle cx="150" cy="100" r="40" fill="var(--color-white)"/>
      <path d="M40 20 L70 40 M260 20 L230 40 M40 180 L70 160 M260 180 L230 160" stroke="var(--color-bg)" stroke-width="3"/>
      <circle cx="150" cy="100" r="52" fill="none" stroke="var(--color-bg)" stroke-width="2" stroke-dasharray="4 6"/>
    {%- when 'print' -%}
      <rect x="40" y="110" width="220" height="40" fill="var(--color-ink)"/>
      <rect x="70" y="40" width="160" height="70" rx="35" fill="var(--color-blue)"/>
      <rect x="120" y="40" width="60" height="70" fill="var(--color-ink)" style="mix-blend-mode: multiply"/>
      <path d="M90 160 L210 160" stroke="var(--color-white)" stroke-width="2" stroke-dasharray="3 5"/>
      <rect x="100" y="150" width="100" height="10" fill="var(--color-white)" stroke="var(--color-ink)"/>
    {%- when 'edition' -%}
      <g stroke="var(--color-ink)" stroke-width="2">
        <rect x="50" y="130" width="200" height="14" fill="var(--color-white)"/>
        <rect x="56" y="116" width="200" height="14" fill="var(--color-bg)"/>
        <rect x="46" y="102" width="200" height="14" fill="var(--color-white)"/>
        <rect x="58" y="88" width="200" height="14" fill="var(--color-bg)"/>
        <rect x="50" y="74" width="200" height="14" fill="var(--color-white)"/>
      </g>
      {%- if caption != blank -%}
        <text x="150" y="52" text-anchor="middle" font-family="DM Mono, monospace" font-size="14" fill="var(--color-ink)">{{ caption | escape }}</text>
      {%- endif -%}
  {%- endcase -%}
</svg>
