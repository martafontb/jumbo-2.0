{% doc %}
  Index-page title block: huge heading with an accent full stop, an optional
  superscript count, and an optional intro spanning the two right-hand columns.

  @param {string} title - Heading text (escaped here)
  @param {number} [count] - Count, e.g. products in a collection
  @param {string} [count_style] - 'sup' (default, "(n)" superscript) or 'accent' (italic blue)
  @param {string} [intro] - Intro HTML (rich text) for the right two columns
  @param {boolean} [show_dot] - Accent full stop, default true
  @param {boolean} [clamp_intro] - On phone, show two lines of a long intro with a Read more toggle. The full text stays in the page source.
{% enddoc %}
<div class="page-title grid">
  <h1 class="title-page page-title__heading">
    {{- title | escape -}}
    {%- unless show_dot == false -%}<span class="dot">.</span>{%- endunless -%}
    {%- if count != blank -%}
      {%- if count_style == 'accent' %} <em class="accent">({{ count }})</em>
      {%- else -%}<sup class="page-title__count label">({{ count }})</sup>
      {%- endif -%}
    {%- endif -%}
  </h1>
  {%- if intro != blank -%}
    {%- assign intro_length = intro | strip_html | size -%}
    {%- assign intro_long = false -%}
    {%- if clamp_intro and intro_length > 110 -%}
      {%- assign intro_long = true -%}
    {%- endif -%}
    <div class="page-title__intro{% if intro_long %} page-title__intro--clamp{% endif %}">
      {%- if intro_long -%}
        <input type="checkbox" class="visually-hidden page-title__more-input" id="IntroMore-{{ title | handle }}">
      {%- endif -%}
      <div class="page-title__intro-text">{{ intro }}</div>
      {%- if intro_long -%}
        <label class="link-mono page-title__more" for="IntroMore-{{ title | handle }}">
          <span class="page-title__more-open">{{ 'sections.collection.read_more' | t }}</span>
          <span class="page-title__more-close">{{ 'sections.collection.read_less' | t }}</span>
        </label>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .page-title {
    align-items: end;
    padding-top: 28px;
    padding-bottom: 14px;
  }

  .page-title__heading {
    overflow-wrap: anywhere;
  }

  .page-title__count {
    margin-left: 0.2em;
    vertical-align: super;
    font-size: var(--text-label);
  }

  .page-title__intro {
    grid-column: span min(2, var(--grid-columns));
    max-width: 50ch;
  }

  .page-title__more {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .page-title__intro--clamp .page-title__intro-text {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .page-title__intro--clamp .page-title__more {
      display: inline-block;
      margin-top: 8px;
    }

    .page-title__more-close,
    .page-title__more-input:checked ~ .page-title__more .page-title__more-open {
      display: none;
    }

    .page-title__more-input:checked ~ .page-title__more .page-title__more-close {
      display: inline;
    }

    .page-title__more-input:checked ~ .page-title__intro-text {
      display: block;
      -webkit-line-clamp: unset;
    }

    .page-title__more-input:focus-visible ~ .page-title__more {
      outline: 2px solid var(--color-ink);
      outline-offset: 2px;
    }
  }

  .page-title .accent {
    font-weight: 500;
  }

  @media screen and (max-width: 749px) {
    .page-title {
      padding-top: 16px;
      gap: 16px;
    }
  }
{% endstylesheet %}
