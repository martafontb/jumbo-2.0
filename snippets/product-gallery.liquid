{% doc %}
  Product media gallery.
  - stack: every media item 4/3 in one column (editions).
  - grid: first item 4/3 full width, then 1/1 two-up (merch).
  - two-up: every item 4/5 portrait, two per row (portrait photography).
  The selected variant's media is shown first. Image alt text can double as
  a small caption pill on secondary images (e.g. "Detail × 12").

  @param {object} product - Product
  @param {object} variant - Selected variant
  @param {string} layout - 'stack', 'grid' or 'two-up'
  @param {string} ground - Background token while images load
  @param {boolean} [captions] - Show alt text as captions on secondary images
  @param {string} [fit] - 'auto' (portrait images contained), 'cover' or 'contain'

  Under 750px the gallery is a swipeable carousel with a counter.

  Zoom: a magnifier icon button on each image opens a full-screen lightbox
  where the image can be panned at 2.5x and stepped with arrow keys.
{% enddoc %}
{%- liquid
  assign featured = variant.featured_media | default: product.featured_media
  assign ground = ground | default: 'blue'
  assign fit = fit | default: 'auto'
  assign media_count = product.media.size | at_least: 1
-%}
<product-gallery class="product-gallery-wrap">
<div
  class="product-gallery product-gallery--{{ layout }}"
  data-gallery
  role="region"
  aria-label="{{ 'products.gallery' | t: title: product.title | escape }}"
  tabindex="-1"
>
  {%- if product.media.size == 0 -%}
    <div class="media product-gallery__item product-gallery__item--first" style="--media-bg: var(--color-{{ ground }});">
      {%- render 'image', placeholder: 'product-1' -%}
    </div>
  {%- else -%}
    {%- if featured -%}
      {%- render 'product-media', media: featured, product: product, ground: ground, first: true, fit: fit -%}
    {%- endif -%}
    {%- for media in product.media -%}
      {%- if media.id == featured.id -%}{%- continue -%}{%- endif -%}
      {%- render 'product-media', media: media, product: product, ground: ground, first: false, caption: captions, fit: fit -%}
    {%- endfor -%}
  {%- endif -%}
</div>
{%- if media_count > 1 -%}
  <span class="pill pill--bg product-gallery__counter" aria-hidden="true"><span data-gallery-index>1</span> / {{ media_count }}</span>
{%- endif -%}
<dialog class="overlay zoom-dialog" data-zoom-dialog aria-label="{{ 'products.zoom.dialog' | t: title: product.title | escape }}">
  <div class="zoom-dialog__stage" data-zoom-stage>
    <img class="zoom-dialog__img" data-zoom-img alt="" width="2400" height="2400">
  </div>
  <button type="button" class="icon-button icon-button--lg zoom-dialog__close" data-zoom-close aria-label="{{ 'products.zoom.close' | t }}">✕</button>
  <button type="button" class="icon-button icon-button--lg zoom-dialog__nav zoom-dialog__nav--prev" data-zoom-prev aria-label="{{ 'products.zoom.previous' | t }}">←</button>
  <button type="button" class="icon-button icon-button--lg zoom-dialog__nav zoom-dialog__nav--next" data-zoom-next aria-label="{{ 'products.zoom.next' | t }}">→</button>
</dialog>
</product-gallery>
<script src="{{ 'product-gallery.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .product-gallery {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--grid-gap);
    align-content: start;
  }

  .product-gallery__item {
    --ratio: 4 / 3;
  }

  .product-gallery--grid,
  .product-gallery--two-up {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-gallery--grid .product-gallery__item {
    --ratio: 1;
  }

  .product-gallery--grid .product-gallery__item--first {
    grid-column: 1 / -1;
    --ratio: 4 / 3;
  }

  .product-gallery--two-up .product-gallery__item {
    --ratio: 4 / 5;
  }

  .product-gallery-wrap {
    position: relative;
  }

  .product-gallery__counter {
    display: none;
  }

  /* Mobile: one image per screen, swiped sideways, with a counter. */
  @media screen and (max-width: 749px) {
    .product-gallery,
    .product-gallery--grid,
    .product-gallery--two-up {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      overscroll-behavior-x: contain;
      scrollbar-width: none;
    }

    .product-gallery::-webkit-scrollbar {
      display: none;
    }

    .product-gallery .product-gallery__item,
    .product-gallery--grid .product-gallery__item,
    .product-gallery--two-up .product-gallery__item {
      flex: 0 0 100%;
      scroll-snap-align: start;
      --ratio: 4 / 5;
    }

    .product-gallery__counter {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 1;
      display: inline-flex;
    }
  }

  .product-gallery__zoom {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 1;
    background: var(--color-bg);
  }

  .product-gallery__zoom:focus-visible {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  /* Desktop: the magnifier fades in on hover or keyboard focus. Touch keeps it visible. */
  @media (hover: hover) and (pointer: fine) {
    .product-gallery__zoom {
      opacity: 0;
      transition: opacity 0.2s;
    }

    .product-gallery__item:hover .product-gallery__zoom,
    .product-gallery__zoom:focus-visible {
      opacity: 1;
    }
  }

  .zoom-dialog {
    inset: 0;
    width: 100vw;
    height: 100%;
    background: var(--color-bg);
  }

  .zoom-dialog__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    cursor: zoom-in;
  }

  .zoom-dialog__stage.is-zoomed {
    cursor: zoom-out;
  }

  .zoom-dialog__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transform-origin: var(--zoom-x, 50%) var(--zoom-y, 50%);
    transition: transform 0.25s ease-out;
    user-select: none;
  }

  .zoom-dialog__stage.is-zoomed .zoom-dialog__img {
    transform: scale(2.5);
  }

  .zoom-dialog__close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: var(--color-bg);
  }

  .zoom-dialog__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    background: var(--color-bg);
  }

  .zoom-dialog__nav--prev { left: 16px; }
  .zoom-dialog__nav--next { right: 16px; }

  .product-gallery__caption {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 1;
    padding: 2px 5px;
    background: var(--color-grey);
    font: 400 var(--text-label-sm) / 1.35 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    pointer-events: none;
  }

  .product-gallery__item > video,
  .product-gallery__item > iframe,
  .product-gallery__item > model-viewer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: var(--media-fit, cover);
  }
{% endstylesheet %}
