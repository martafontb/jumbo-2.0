{% doc %}
  Product card: coloured-ground image (radius 20), then title and price on a
  ruled line, then an optional mono caption. The caption and tag come from
  the product metafields `custom.card_meta` and `custom.card_tag` unless
  passed in.

  @param {object} [product] - Product. Omit to render a placeholder card (theme editor only).
  @param {string} [ground] - Image background token: blue | red | grey | ink | bg
  @param {string} [ratio] - CSS aspect ratio, default '3 / 4'
  @param {string} [scale] - 'lg' (26px title, default) or 'sm' (20px)
  @param {boolean} [show_tag] - Show the tag pill on the image
  @param {string} [sizes] - Image `sizes` attribute
  @param {boolean} [eager] - Load the image eagerly
  @param {image} [image] - Replaces the product's featured image
  @param {object} [video] - Plays instead of the image (muted, looping)
  @param {string} [class] - Extra classes on the card
  @param {string} [heading_tag] - Title element, default 'span' (use 'h2'/'h3' in grids)
  @param {boolean} [reserve_stars] - Keep the rating row's height when a product has no rating, so cards in a row stay the same height
  @param {boolean} [quick_add] - Show an add-to-cart button under the card. Products with several variants get a "Choose options" link instead.
{% enddoc %}
{%- liquid
  assign ground = ground | default: 'grey'
  assign ratio = ratio | default: '3 / 4'
  assign card_size = scale | default: 'lg'
  assign sizes = sizes | default: '(min-width: 750px) 33vw, 60vw'
  assign caption = product.metafields.custom.card_meta.value
  assign tag = product.metafields.custom.card_tag.value
  assign card_image = image | default: product.featured_media
  if product == blank
    assign placeholder_title = 'products.placeholder_title' | t
  endif
-%}
<div class="product-card product-card--{{ card_size }} product-card--bg-{{ settings.card_background | default: 'hover' }} {{ class }}">
  <a class="product-card__link" href="{{ product.url | default: '#' }}">
    <div class="media product-card__media" style="--ratio: {{ ratio }}; --card-ground: var(--color-{{ ground }}); --media-fit: {{ settings.card_image_fit | default: 'cover' }};">
      {%- render 'image-or-video',
        video: video,
        image: card_image,
        sizes: sizes,
        alt_fallback: product.title,
        eager: eager,
        placeholder: 'product-1'
      -%}
      {%- if show_tag and tag != blank -%}
        <span class="pill pill--grey pill--outline">{{ tag | escape }}</span>
      {%- endif -%}
      {%- unless product.available or product == blank -%}
        <span class="pill pill--bg product-card__status">{{ 'products.sold_out' | t }}</span>
      {%- endunless -%}
    </div>
    <span class="product-card__meta">
      {%- assign title_tag = heading_tag | default: 'span' -%}
      <{{ title_tag }} class="product-card__title">{{ product.title | default: placeholder_title | escape }}</{{ title_tag }}>
      {%- if product != blank -%}
        {%- render 'price', product: product -%}
      {%- endif -%}
    </span>
  </a>
  {%- if caption != blank -%}
    <span class="product-card__caption">{{ caption | escape }}</span>
  {%- endif -%}
  {%- if product != blank and product.metafields.reviews.rating.value != blank -%}
    {%- render 'stars', rating: product.metafields.reviews.rating.value.rating, class: 'product-card__stars' -%}
  {%- elsif reserve_stars and product != blank -%}
    <span class="product-card__stars product-card__stars--empty" aria-hidden="true"></span>
  {%- endif -%}
  {%- if quick_add and product != blank -%}
    <div class="product-card__quick-add">
      {%- if product.has_only_default_variant -%}
        {%- render 'add-to-cart-form', product: product, class: 'button--full' -%}
      {%- else -%}
        <a class="button button--small button--full" href="{{ product.url }}">{{ 'products.choose_options' | t }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .product-card__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .product-card__link:hover {
    color: var(--color-ink);
  }

  /* Card colour: always the product's colour, or only on hover and focus. */
  .product-card__media {
    background: var(--card-ground);
    transition: background-color 0.3s var(--ease-out-expo);
  }

  .product-card--bg-hover .product-card__media {
    background: var(--color-bg);
  }

  .product-card--bg-hover .product-card__link:hover .product-card__media,
  .product-card--bg-hover .product-card__link:focus-visible .product-card__media {
    background: var(--card-ground);
  }

  .product-card__status {
    top: auto;
    bottom: 8px;
  }

  .media > .product-card__status {
    top: auto;
  }

  .product-card__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-top: 6px;
    border-top: var(--border);
  }

  .product-card__title {
    margin: 0;
    min-width: 0;
    font: 400 var(--text-card-lg) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
  }

  .product-card--sm .product-card__title {
    font-size: var(--text-card-sm);
    line-height: 1.1;
  }

  .product-card__caption {
    font: 400 var(--text-label-sm) / 1.35 var(--font-mono);
    letter-spacing: var(--tracking-label);
  }

  .product-card--upper .product-card__caption {
    text-transform: uppercase;
  }

  .product-card__stars {
    font-size: 12px;
  }

  .product-card__stars--empty {
    display: block;
    height: 12px;
  }

  .product-card__quick-add {
    margin-top: 4px;
  }
{% endstylesheet %}
