{% doc %}
  Inner content of the cart drawer (re-rendered after every cart change).

  @param {object} drawer - cart-drawer section settings
{% enddoc %}
<div class="drawer__head">
  <h2 class="drawer__title" id="CartDrawerTitle">
    {{- 'cart.title' | t -}}
    <span class="cart-drawer__count" data-cart-count>{{ cart.item_count }}</span>
  </h2>
  <button type="button" class="icon-button" data-overlay-close aria-label="{{ 'cart.close' | t }}"><span aria-hidden="true">×</span></button>
</div>

<div class="cart-drawer__body">
  {%- render 'cart-shipping-progress', variant: 'band' -%}
  <form action="{{ routes.cart_url }}" method="post" id="CartDrawerForm" novalidate>
    {%- if cart.item_count == 0 -%}
      {%- assign empty_text = 'cart.empty' | t -%}
      <p class="cart-drawer__empty">{{ drawer.empty_text | default: empty_text | escape }}</p>
      <div class="cart-drawer__empty-links">
        {%- if drawer.empty_link_1_label != blank -%}
          <a class="button" href="{{ drawer.empty_link_1_url | default: routes.all_products_collection_url }}">{{ drawer.empty_link_1_label | escape }}</a>
        {%- endif -%}
        {%- if drawer.empty_link_2_label != blank -%}
          <a class="button button--secondary" href="{{ drawer.empty_link_2_url | default: routes.root_url }}">{{ drawer.empty_link_2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- else -%}
      <ul class="cart-drawer__lines" role="list">
        {%- for item in cart.items -%}
          {%- render 'cart-line', item: item, index: forloop.index, size: 'drawer' -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </form>

    {%- render 'cart-upsell', collection: drawer.upsell_collection, limit: drawer.upsell_limit, heading: drawer.upsell_heading -%}
</div>

{%- if cart.item_count > 0 -%}
  <div class="cart-drawer__foot">
    {%- render 'cart-gift', form_id: 'CartDrawerForm' -%}
    <p class="cart-drawer__subtotal">
      <span class="label">{{ 'cart.subtotal' | t }}</span>
      <span class="cart-drawer__amount">{{ cart.total_price | money }}</span>
    </p>
    {%- if cart.cart_level_discount_applications.size > 0 -%}
      <ul class="label label--sm cart-drawer__discounts" role="list">
        {%- for discount in cart.cart_level_discount_applications -%}
          <li>{{ discount.title | escape }} (−{{ discount.total_allocated_amount | money }})</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
    <button type="submit" name="checkout" form="CartDrawerForm" class="button button--full cart-drawer__checkout">{{ 'cart.checkout' | t }}</button>
    <a class="link-mono cart-drawer__full" href="{{ routes.cart_url }}">{{ 'cart.view_full' | t }}</a>
  </div>
{%- endif -%}
<p class="visually-hidden" role="status" data-cart-status></p>

{% stylesheet %}
  .cart-drawer__count {
    padding: 3px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-grey);
    font: 400 14px / 1 var(--font-mono);
    letter-spacing: 0;
  }

  .cart-drawer__body {
    flex: 1;
    overflow: auto;
    padding: 0 16px;
  }

  .cart-drawer__body > .shipping-progress {
    margin-top: 12px;
  }

  .cart-drawer__empty-links {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 16px;
  }

  .cart-drawer__lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cart-drawer__empty {
    margin: 24px 0;
    font: 500 32px / 1.05 var(--font-display);
    letter-spacing: -0.03em;
  }

  .cart-drawer__foot {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex-shrink: 0;
    padding: 16px;
    border-top: var(--border);
  }

  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .cart-drawer__amount {
    font: 500 44px / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .cart-drawer__checkout {
    font-size: 13px;
  }

  .cart-drawer__full {
    align-self: center;
  }
{% endstylesheet %}
