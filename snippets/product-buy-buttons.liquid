{% doc %}
  Product form: optional quantity stepper, Add to cart (with an optional live
  total), optional express checkout and a "View cart (n)" link revealed
  after adding. Respects quantity rules (min / max / increment).

  For products with several variants, the hidden id input starts disabled:
  JS enables it, and without JS the variant picker's <noscript> select
  supplies the id instead.

  @param {object} product - Product
  @param {object} variant - Selected variant
  @param {object} block - "Buy buttons" block
  @param {string} form_id - Form id

  Sold-out variants also show a notify-me form. It posts to Shopify's contact
  form, so the message (product, variant, link and the customer's email) lands
  in the store's contact inbox. No app needed. Swap it for a back-in-stock app
  block later if you add one.
{% enddoc %}
{%- liquid
  assign rule = variant.quantity_rule
  assign min_qty = rule.min | default: 1
  assign step = rule.increment | default: 1
  assign label = 'products.add_to_cart' | t
  if variant.available == false
    assign label = 'products.sold_out' | t
  endif
-%}
<product-form
  class="buy-buttons"
  data-added-label="{{ 'products.added_another' | t | escape }}"
  data-price="{{ variant.price }}"
  data-money-format="{{ shop.money_format | escape }}"
>
  {%- form 'product', product, id: form_id, class: 'buy-buttons__form', novalidate: 'novalidate' -%}
    <input
      type="hidden"
      name="id"
      value="{{ variant.id }}"
      data-variant-input
      {% unless product.has_only_default_variant %}disabled{% endunless %}
    >
    {%- if block.settings.show_quantity -%}
      <div class="buy-buttons__qty-group">
        <label class="buy-buttons__qty-label" for="Quantity-{{ form_id }}">{{ 'products.quantity' | t }}</label>
        <quantity-input class="stepper buy-buttons__qty" style="--stepper-size: 44px;">
          <button type="button" class="stepper__button" data-step="down" aria-label="{{ 'products.quantity_decrease' | t }}">−</button>
          <input
            class="stepper__input"
            type="number"
            id="Quantity-{{ form_id }}"
            name="quantity"
            value="{{ min_qty }}"
            min="{{ min_qty }}"
            {% if rule.max %}max="{{ rule.max }}"{% endif %}
            step="{{ step }}"
            inputmode="numeric"
          >
          <button type="button" class="stepper__button" data-step="up" aria-label="{{ 'products.quantity_increase' | t }}">+</button>
        </quantity-input>
      </div>
    {%- else -%}
      <input type="hidden" name="quantity" value="{{ min_qty }}">
    {%- endif -%}

    <div class="buy-buttons__row">
      <button
        type="submit"
        name="add"
        class="button buy-buttons__add"
        {% unless variant.available %}disabled{% endunless %}
      >
        <span data-label>
          {{- label -}}
          {%- if block.settings.show_total and variant.available %} · <span data-total>{{ variant.price | times: min_qty | money }}</span>{% endif -%}
        </span>
      </button>
    </div>

    <p class="form-message form-message--error" role="alert" data-error hidden></p>

    {%- if block.settings.show_dynamic_checkout and variant.available -%}
      {{ form | payment_button }}
    {%- endif -%}
  {%- endform -%}

  {%- if variant.available == false -%}
    {%- assign notify_id = 'Notify-' | append: form_id -%}
    {%- form 'contact', id: notify_id, class: 'buy-buttons__notify' -%}
      {%- if form.posted_successfully? -%}
        <p class="buy-buttons__notify-done" role="status">{{ 'products.notify.success' | t }}</p>
      {%- else -%}
        <p class="buy-buttons__notify-title">{{ 'products.notify.title' | t }}</p>
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ 'products.notify.error' | t }}</p>
        {%- endif -%}
        <input type="hidden" name="contact[body]" value="{{ 'products.notify.body' | t: product: product.title, variant: variant.title, url: product.url | prepend: shop.url | escape }}">
        <div class="buy-buttons__notify-row">
          <label class="visually-hidden" for="{{ notify_id }}-email">{{ 'products.notify.email' | t }}</label>
          <input
            class="buy-buttons__notify-input"
            type="email"
            id="{{ notify_id }}-email"
            name="contact[email]"
            autocomplete="email"
            required
            placeholder="{{ 'newsletter.placeholder' | t }}"
            value="{{ form.email | escape }}"
          >
          <button type="submit" class="button">{{ 'products.notify.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  {%- endif -%}

  {%- if block.settings.show_view_cart -%}
    <a class="buy-buttons__view-cart" href="{{ routes.cart_url }}" data-overlay-open="CartDrawer" data-view-cart hidden>
      {{- 'products.view_cart' | t -}} (<span data-cart-count>{{ cart.item_count }}</span>) →
    </a>
  {%- endif -%}
</product-form>

{% stylesheet %}
  .buy-buttons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .buy-buttons__form {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .buy-buttons__qty-group {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .buy-buttons__qty-label {
    font: 400 var(--text-label) / 1.35 var(--font-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    opacity: var(--opacity-muted);
  }

  .buy-buttons__qty .stepper__button {
    font-size: 18px;
  }

  .buy-buttons__row {
    display: flex;
  }

  .buy-buttons__notify {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }

  .buy-buttons__notify-title,
  .buy-buttons__notify-done {
    margin: 0;
    font-size: 14px;
  }

  .buy-buttons__notify-row {
    display: flex;
    gap: 6px;
  }

  .buy-buttons__notify-input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 8px 16px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    font-size: 16px; /* 16px stops iOS zooming into the field */
  }

  .buy-buttons__add {
    flex: 1;
    min-height: 64px;
    font-size: 15px;
  }

  .buy-buttons__view-cart {
    padding: 18px 12px;
    border: var(--border);
    background: var(--color-blue);
    color: var(--color-ink); /* ink on blue is 6.0:1; white on blue is 2.7:1 */
    font: 400 var(--text-label) / 1.2 var(--font-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    text-align: center;
    text-decoration: none;
  }

  .buy-buttons__view-cart:hover {
    background: var(--color-grey);
    color: var(--color-ink);
  }

  .shopify-payment-button__button {
    border-radius: var(--radius-pill);
    overflow: hidden;
  }
{% endstylesheet %}
