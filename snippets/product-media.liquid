{% doc %}
  One product media item (image, video, external video or 3D model) in a
  rounded 4/3 frame.

  @param {object} media - Product media
  @param {object} product - Product (for alt fallback)
  @param {string} ground - Background token
  @param {boolean} first - First item: eager-loaded, full width
  @param {boolean} [caption] - Show alt text as a caption pill
  @param {string} [fit] - 'auto' (portrait contained), 'cover' or 'contain'
{% enddoc %}
{%- liquid
  assign media_fit = fit | default: 'auto'
  if media_fit == 'auto'
    assign media_fit = 'cover'
    if media.preview_image.aspect_ratio < 1
      assign media_fit = 'contain'
    endif
  endif
-%}
<div
  class="media product-gallery__item{% if first %} product-gallery__item--first{% endif %}"
  style="--media-bg: var(--color-{{ ground }}); --media-fit: {{ media_fit }};"
  data-media-id="{{ media.id }}"
>
  {%- case media.media_type -%}
    {%- when 'video' -%}
      {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1600x' }}
    {%- when 'external_video' -%}
      {{ media | external_video_tag: loading: 'lazy' }}
    {%- when 'model' -%}
      {{ media | model_viewer_tag: reveal: 'interaction', toggleable: true }}
    {%- else -%}
      {%- render 'image',
        image: media.preview_image,
        sizes: '(min-width: 750px) 66vw, 100vw',
        alt_fallback: product.title,
        eager: first
      -%}
      {%- if caption and first == false and media.alt != blank -%}
        <span class="product-gallery__caption" aria-hidden="true">{{ media.alt | escape }}</span>
      {%- endif -%}
  {%- endcase -%}
</div>
