{% comment %}
  Product
  Gallery across two columns, sticky info column on the right. The info
  column is built from blocks, so editions and merch share this section with
  different block setups (see product.json and product.merch.json).

  Variant changes re-render the price, picker state, buy buttons and gallery
  through the Section Rendering API. Without JS, a plain variant <select>
  (in <noscript>) posts the right variant id.

  Metafields read here (all optional): custom.artist (artist metaobject:
  name, portrait, bio …), custom.year, custom.edition_size,
  custom.edition_detail, custom.inks, custom.paper, custom.dimensions,
  custom.format, custom.material, custom.size_chart.

  "Sticky add-to-cart bar on mobile" shows a bottom bar under 750px while
  the Buy buttons block is off screen. Its button submits the main product
  form (form="…"), so quantity and variant come from the main form.
{% endcomment %}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
  assign artist = product.metafields.custom.artist.value
  assign crumb_collection = collection | default: product.collections.first
-%}
<product-info
  class="page main-product"
  data-section-id="{{ section.id }}"
  data-url="{{ product.url }}"
  {% if section.settings.sticky_info %}data-sticky{% endif %}
>
  <div class="main-product__grid">
    <div class="main-product__media" id="Gallery-{{ section.id }}" data-dynamic>
      {%- render 'product-gallery',
        fit: section.settings.gallery_fit,
        product: product,
        variant: current_variant,
        layout: section.settings.gallery_layout,
        ground: section.settings.gallery_ground,
        captions: section.settings.captions
      -%}
    </div>

    <div class="main-product__info">
      <div class="main-product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'breadcrumb' -%}
              <nav class="label label--sm main-product__crumb" aria-label="{{ 'products.breadcrumb' | t }}" {{ block.shopify_attributes }}>
                {%- if crumb_collection -%}
                  <a class="tap-target" href="{{ crumb_collection.url }}">{{ crumb_collection.title | escape }}</a>
                {%- else -%}
                  <a class="tap-target" href="{{ routes.all_products_collection_url }}">{{ 'products.shop' | t }}</a>
                {%- endif -%}
                {%- if artist != blank -%}
                  <span aria-hidden="true"> / </span>{{ artist.name.value | escape }}
                {%- elsif product.type != blank -%}
                  <span aria-hidden="true"> / </span>{{ product.type | escape }}
                {%- endif -%}
              </nav>

            {%- when 'switcher' -%}
              {%- if block.settings.products.size > 1 -%}
                <nav class="main-product__switcher" aria-label="{{ block.settings.label | escape }}" {{ block.shopify_attributes }}>
                  {%- for item in block.settings.products -%}
                    <a class="chip main-product__switch" href="{{ item.url }}" {% if item.id == product.id %}aria-current="page"{% endif %}>
                      {{- item.metafields.custom.short_title.value | default: item.title | escape -}}
                    </a>
                  {%- endfor -%}
                </nav>
              {%- endif -%}

            {%- when 'title' -%}
              {%- liquid
                assign words = product.title | split: ' '
                assign last_word = words | last
                assign head_words = ''
                for word in words
                  unless forloop.last
                    assign head_words = head_words | append: word | append: ' '
                  endunless
                endfor
              -%}
              {%- liquid
                assign accent_color = block.settings.accent_color
                unless accent_color == 'blue' or accent_color == 'red' or accent_color == 'ink'
                  assign accent_color = 'blue'
                endunless
              -%}
              <h1 class="title-product main-product__title" {{ block.shopify_attributes }}>
                {%- if block.settings.accent and words.size > 1 -%}
                  {{ head_words | escape }}<em class="main-product__accent" style="--accent: var(--color-{{ accent_color }});">{{ last_word | escape }}</em>
                {%- else -%}
                  {{ product.title | escape }}
                {%- endif -%}
              </h1>

            {%- when 'artist' -%}
              {%- liquid
                assign artist_name = artist.name.value
                if artist_name == blank and block.settings.vendor_fallback
                  assign artist_name = product.vendor
                endif
                assign year = product.metafields.custom.year.value
              -%}
              {%- if artist_name != blank -%}
                {%- if artist.system.url != blank -%}
                  <a class="link-mono main-product__artist" href="{{ artist.system.url }}" {{ block.shopify_attributes }}>
                    {{- artist_name | escape }}{% if year != blank %} · {{ year }}{% endif -%}
                  </a>
                {%- else -%}
                  <p class="label main-product__artist" {{ block.shopify_attributes }}>
                    {{- artist_name | escape }}{% if year != blank %} · {{ year }}{% endif -%}
                  </p>
                {%- endif -%}
              {%- endif -%}

            {%- when 'price' -%}
              <div class="main-product__price-block" id="Price-{{ section.id }}" data-dynamic {{ block.shopify_attributes }}>
                {%- render 'product-price-block', product: product, variant: current_variant, block: block -%}
              </div>

            {%- when 'specs' -%}
              {%- render 'product-specs', product: product, block: block -%}

            {%- when 'variant_picker' -%}
              <div id="Picker-{{ section.id }}" data-dynamic-picker {{ block.shopify_attributes }}>
                {%- render 'product-variant-picker', product: product, variant: current_variant, form_id: form_id, section_id: section.id -%}
              </div>

            {%- when 'buy_buttons' -%}
              <div class="main-product__buy" id="Buy-{{ section.id }}" data-dynamic {{ block.shopify_attributes }}>
                {%- render 'product-buy-buttons', product: product, variant: current_variant, block: block, form_id: form_id -%}
              </div>

            {%- when 'guide_link' -%}
              {%- if section.settings.guide_enabled -%}
                <button type="button" class="link-mono main-product__guide" data-overlay-open="SizeGuide-{{ section.id }}" aria-haspopup="dialog" {{ block.shopify_attributes }}>
                  {{- block.settings.label | escape -}}
                </button>
              {%- endif -%}

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="rte main-product__description" {{ block.shopify_attributes }}>{{ product.description }}</div>
              {%- endif -%}

            {%- when 'text' -%}
              {%- if block.settings.text != blank -%}
                <div class="rte main-product__text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- assign buy_block = section.blocks | where: 'type', 'buy_buttons' | first -%}
  {%- if section.settings.sticky_bar and buy_block -%}
    <div class="sticky-buy" id="StickyBuy-{{ section.id }}" data-dynamic data-sticky-buy hidden>
      {%- assign sticky_media = current_variant.featured_media | default: product.featured_media -%}
      {%- if sticky_media -%}
        <div class="media sticky-buy__media" style="--ratio: 1;">
          {%- render 'image', image: sticky_media, sizes: '48px', widths: '96, 144', decorative: true -%}
        </div>
      {%- endif -%}
      <div class="sticky-buy__text">
        <p class="sticky-buy__title">{{ product.title | escape }}</p>
        <p class="sticky-buy__meta">
          {%- unless product.has_only_default_variant -%}{{ current_variant.title | escape }} · {% endunless -%}
          {{- current_variant.price | money -}}
        </p>
      </div>
      <button
        type="submit"
        form="{{ form_id }}"
        name="add"
        class="button sticky-buy__button"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        <span data-label>
          {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
        </span>
      </button>
    </div>
  {%- endif -%}

  {%- if section.settings.guide_enabled -%}
    {%- assign guide_id = 'SizeGuide-' | append: section.id -%}
    {%- render 'size-guide', settings: section.settings, id: guide_id -%}
  {%- endif -%}
</product-info>

<script src="{{ 'product-info.js' | asset_url }}" type="module"></script>
<script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
<script src="{{ 'quantity-input.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .sticky-buy {
    display: none;
  }

  @media (max-width: 749px) {
    .sticky-buy:not([hidden]) {
      position: fixed;
      inset: auto 8px 8px;
      z-index: 9;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 6px 6px 10px;
      border: var(--border);
      border-radius: var(--radius-pill);
      background: var(--color-bg);
      visibility: hidden;
      opacity: 0;
      translate: 0 8px;
      transition: opacity 0.25s, translate 0.25s, visibility 0.25s;
    }

    .sticky-buy.is-visible {
      visibility: visible;
      opacity: 1;
      translate: 0 0;
    }

    .sticky-buy__media {
      flex-shrink: 0;
      width: 44px;
      border-radius: 50%;
    }

    .sticky-buy__text {
      flex: 1;
      min-width: 0;
    }

    .sticky-buy__title {
      margin: 0;
      overflow: hidden;
      font: 500 16px / 1.1 var(--font-display);
      letter-spacing: -0.02em;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .sticky-buy__meta {
      margin: 2px 0 0;
      overflow: hidden;
      font: 400 var(--text-label-sm) / 1.3 var(--font-mono);
      letter-spacing: var(--tracking-label);
      text-transform: uppercase;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .sticky-buy__button {
      flex-shrink: 0;
      min-height: 44px;
      padding: 12px 18px;
    }

    html.has-sticky-buy .site-footer {
      padding-bottom: 88px;
    }
  }

  .main-product__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .main-product__media {
    grid-column: span 2;
  }

  .main-product__info {
    padding: 0 clamp(16px, 3vw, 48px);
  }

  .main-product__info-inner {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-top: clamp(16px, 4vw, 64px);
  }

  [data-sticky] .main-product__info-inner {
    position: sticky;
    top: 64px;
  }

  .main-product__crumb a {
    color: var(--color-ink);
  }

  .main-product__switcher {
    display: flex;
    gap: 4px;
  }

  .main-product__switch {
    flex: 1;
    justify-content: center;
    padding: 8px;
  }

  .main-product__title {
    margin: 0;
    overflow-wrap: anywhere;
  }

  .main-product__accent {
    color: var(--accent);
    font-weight: 500;
  }

  .main-product__artist {
    align-self: flex-start;
  }

  .main-product__guide {
    align-self: flex-start;
  }

  .main-product__description,
  .main-product__text {
    max-width: 40ch;
  }

  @media screen and (max-width: 749px) {
    .main-product__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .main-product__media {
      grid-column: auto;
    }

    .main-product__info {
      padding: 0;
    }

    [data-sticky] .main-product__info-inner {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "max_blocks": 20,
  "settings": [
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        { "value": "two-up", "label": "Two-up (portrait 4:5, two per row)" },
        { "value": "stack", "label": "Stacked (one column, 4:3)" },
        { "value": "grid", "label": "Grid (large first, then two-up)" }
      ],
      "default": "two-up"
    },
    {
      "type": "select",
      "id": "gallery_ground",
      "label": "Image background",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" },
        { "value": "ink", "label": "Ink" }
      ],
      "default": "blue"
    },
    {
      "type": "select",
      "id": "gallery_fit",
      "label": "Image fit",
      "options": [
        { "value": "auto", "label": "Auto: crop landscape, show portrait whole" },
        { "value": "cover", "label": "Fill the frame (crop)" },
        { "value": "contain", "label": "Show the whole image" }
      ],
      "default": "auto",
      "info": "\"Show the whole image\" suits packshots and transparent PNGs; the image background fills the rest of the frame."
    },
    { "type": "checkbox", "id": "captions", "label": "Show image alt text as a caption on secondary images", "default": true },
    { "type": "checkbox", "id": "sticky_info", "label": "Sticky info column on desktop", "default": true },
    { "type": "checkbox", "id": "sticky_bar", "label": "Sticky add-to-cart bar on mobile", "info": "Shows the price and Add to cart at the bottom of the screen while the buy buttons are scrolled out of view.", "default": true },
    { "type": "header", "content": "Size & shipping guide" },
    { "type": "checkbox", "id": "guide_enabled", "label": "Enable guide drawer", "default": true },
    { "type": "text", "id": "guide_title", "label": "Title", "default": "Guide" },
    {
      "type": "textarea",
      "id": "guide_sizes",
      "label": "Sizes",
      "info": "One per line: Size | Dimensions | Note",
      "default": "A2 | 420 × 594 mm | Poster\nA3 | 297 × 420 mm | Print\nA4 | 210 × 297 mm | Zine spread"
    },
    { "type": "richtext", "id": "guide_sizes_note", "label": "Sizes note" },
    {
      "type": "textarea",
      "id": "guide_shipping",
      "label": "Shipping zones",
      "info": "One per line: Zone | Delivery time | Price. Keep in sync with Settings > Shipping.",
      "default": "UK | 3–4 working days | £6\nEurope | 5–8 working days | £12\nWorldwide | 7–14 working days | £18"
    },
    { "type": "richtext", "id": "guide_shipping_note", "label": "Shipping note", "default": "<p>Free UK shipping over £75. Everything ships flat in a board envelope with tracking.</p>" },
    { "type": "text", "id": "guide_returns_heading", "label": "Returns heading", "default": "14 days to change your mind." },
    { "type": "richtext", "id": "guide_returns_text", "label": "Returns text", "default": "<p>Send unused prints back flat in the original envelope. We refund once they arrive. Damaged in the post? Send us a photo and we'll reprint or refund.</p>" }
  ],
  "blocks": [
    { "type": "@app" },
    { "type": "breadcrumb", "name": "Breadcrumb", "limit": 1, "settings": [] },
    {
      "type": "switcher",
      "name": "Product switcher",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Chips linking sibling products, e.g. Tee / Hoodie / Tote. Uses the custom.short_title metafield when set." },
        { "type": "product_list", "id": "products", "label": "Products", "limit": 6 },
        { "type": "text", "id": "label", "label": "Accessible label", "default": "Related items" }
      ]
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "accent", "label": "Accent the last word (italic, coloured)", "default": true },
        {
          "type": "select",
          "id": "accent_color",
          "label": "Accent colour",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "ink", "label": "Ink" }
          ],
          "default": "blue"
        }
      ]
    },
    {
      "type": "artist",
      "name": "Artist line",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Shows the custom.artist metaobject's name and custom.year, linking to the artist page." },
        { "type": "checkbox", "id": "vendor_fallback", "label": "Use the vendor when no artist is set", "default": false }
      ]
    },
    {
      "type": "price",
      "name": "Price and stock",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_edition", "label": "Show edition stock (needs custom.edition_size and tracked inventory)", "default": true },
        { "type": "checkbox", "id": "show_in_stock", "label": "Show “In stock” otherwise", "default": true },
        { "type": "checkbox", "id": "show_tax_note", "label": "Show tax and shipping note", "default": false }
      ]
    },
    {
      "type": "specs",
      "name": "Specs",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label_edition", "label": "Edition label", "default": "Edition" },
        { "type": "text", "id": "label_inks", "label": "Inks label", "default": "Inks" },
        { "type": "text", "id": "label_paper", "label": "Paper label", "default": "Paper" },
        { "type": "text", "id": "label_dimensions", "label": "Size label", "default": "Size" },
        { "type": "text", "id": "label_format", "label": "Format label", "default": "Format" },
        { "type": "text", "id": "label_material", "label": "Material label", "default": "Material" },
        { "type": "textarea", "id": "extra_rows", "label": "Extra rows", "info": "Same for every product using this template. One per line: Label | Value" }
      ]
    },
    { "type": "variant_picker", "name": "Variant picker", "limit": 1, "settings": [] },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": false },
        { "type": "checkbox", "id": "show_total", "label": "Show total on the button", "info": "E.g. “Add to cart · £56”, updated with the quantity.", "default": false },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": false },
        { "type": "checkbox", "id": "show_view_cart", "label": "Show “View cart” after adding", "default": true }
      ]
    },
    {
      "type": "guide_link",
      "name": "Guide link",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Size & shipping guide →" }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1, "settings": [] },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Each piece is printed by hand, so ink density and registration vary slightly.</p>" }
      ]
    }
  ]
}
{% endschema %}
