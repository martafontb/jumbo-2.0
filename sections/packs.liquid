{% comment %}
  Packs
  "Buy together, pay less": cards for bundle products. Each "Pack" block
  picks a product (e.g. a bundle made with Shopify Bundles). The saving pill
  and struck-through price come from the product's compare-at price, so
  nothing is calculated in the theme. The button adds the pack to the cart.
{% endcomment %}
{%- liquid
  assign packs = section.blocks | where: 'type', 'pack'
  assign grounds = section.settings.grounds | split: ','
  if grounds.size == 0
    assign grounds = 'grey' | split: ','
  endif
-%}
<section class="page packs space-{{ section.settings.spacing }}">
  {%- render 'section-head', label: section.settings.label, color: section.settings.label_color, caption: section.settings.caption -%}
  <div class="packs__grid">
    {%- for block in packs -%}
      {%- liquid
        assign product = block.settings.product
        assign variant = product.selected_or_first_available_variant
        assign ground_index = forloop.index0 | modulo: grounds.size
        assign ground = grounds[ground_index] | strip
        assign saving = 0
        if variant.compare_at_price > variant.price
          assign saving = variant.compare_at_price | minus: variant.price
        endif
        assign pack_image = block.settings.image | default: product.featured_media
        assign blurb = block.settings.blurb
        if blurb == blank and product != blank
          assign blurb = product.description | strip_html | truncatewords: 14
        endif
      -%}
      <div class="packs__card" {{ block.shopify_attributes }}>
        <a class="packs__link" href="{{ product.url | default: '#' }}">
          <div class="media" style="--ratio: 3 / 4; --media-bg: var(--color-{{ ground }});">
            {%- render 'image',
              image: pack_image,
              sizes: '(min-width: 750px) 33vw, 100vw',
              alt_fallback: product.title,
              placeholder: 'product-2'
            -%}
            {%- if saving > 0 -%}
              {%- assign saving_money = saving | money_without_trailing_zeros -%}
              <span class="pill pill--red">{{ 'products.save' | t: amount: saving_money }}</span>
            {%- endif -%}
          </div>
          <span class="packs__meta">
            <span class="packs__title">{{ product.title | default: block.settings.title | escape }}</span>
            {%- if product != blank -%}{%- render 'price', product: product, variant: variant -%}{%- endif -%}
          </span>
        </a>
        {%- if blurb != blank -%}
          <p class="packs__blurb">{{ blurb | escape }}</p>
        {%- endif -%}
        {%- if product != blank -%}
          {%- render 'add-to-cart-form', product: product, label: section.settings.button_label, class: 'button--full packs__button' -%}
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .packs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .packs__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 8px;
  }

  .packs__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .packs__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding-top: 6px;
    border-top: var(--border);
  }

  .packs__title {
    font: 400 var(--text-card-sm) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .packs__blurb {
    font: 400 14px / 1.3 var(--font-display);
  }

  .packs__card .add-to-cart {
    margin-top: auto;
  }

  .packs__button {
    min-height: 40px;
    padding: 12px;
  }

  @media screen and (max-width: 749px) {
    .packs__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Packs",
  "class": "section-packs",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Packs" },
    {
      "type": "select",
      "id": "label_color",
      "label": "Label colour",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" }
      ],
      "default": "blue"
    },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Buy together, pay less" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add" },
    {
      "type": "text",
      "id": "grounds",
      "label": "Card colours",
      "info": "Comma-separated, repeating: blue, red, grey, ink, bg.",
      "default": "grey, blue, red"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Set a compare-at price on the product to show the saving." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Defaults to the product image." },
        { "type": "text", "id": "title", "label": "Title", "info": "Used only when no product is selected." },
        { "type": "text", "id": "blurb", "label": "What's inside", "info": "Defaults to the start of the product description." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Packs",
      "blocks": [
        { "type": "pack", "settings": { "title": "Starter Pack" } },
        { "type": "pack", "settings": { "title": "Zine Pack" } },
        { "type": "pack", "settings": { "title": "Studio Pack" } }
      ]
    }
  ]
}
{% endschema %}
