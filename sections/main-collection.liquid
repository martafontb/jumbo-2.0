{% comment %}
  Collection (PLP)
  Title with product count and intro, a sticky filter bar (chips + sort) and
  a gap-free grid where products span one, two or three columns.

  - Span: a "Product layout" block for that product (which can also replace
    its image with another image or a video), otherwise the product
    metafield `custom.card_span` (1, 2 or 3). Wide cards are
    clamped to fit the row and the last card stretches to finish it, as in
    the design. Ratio follows span: 1 → 3/4, 2 → 3/2, 3 → 9/4. On mobile
    every card is one column (3/4).
  - Card colour: metafield `custom.card_ground` (blue, red, grey, ink, bg),
    otherwise the section's repeating colour list.
  - Chips: either links from a menu (e.g. Editions, Zines, Books) or the
    values of the first list-type Storefront filter (e.g. Product type).
  - "Studio note" (coloured quote) and "Media" (image or video, optional
    link) blocks are tiles inserted after the Nth product on the first page.
  Filtering and sorting use Shopify's URL parameters, so they work without JS.
{% endcomment %}
{%- render 'section-border', section: section -%}
{%- liquid
  assign grounds = section.settings.grounds | split: ','
  if grounds.size == 0
    assign grounds = 'grey' | split: ','
  endif
  assign layouts = section.blocks | where: 'type', 'product_layout'
  assign title = section.settings.title | default: collection.title
  assign intro = collection.description
  if section.settings.intro != blank
    assign intro = section.settings.intro
  endif
  assign sort_by = collection.sort_by | default: collection.default_sort_by
-%}

{%- paginate collection.products by section.settings.per_page -%}
  <div class="page main-collection">
    {%- comment -%} Solid strip behind the blended header so the filter bar can stick under it. {%- endcomment -%}
    <div class="main-collection__strip" aria-hidden="true"><div></div></div>

    {%- render 'page-title', title: title, count: collection.products_count, intro: intro -%}

    <div class="main-collection__bar">
      <nav class="main-collection__chips" aria-label="{{ 'sections.collection.filter_label' | t }}">
        {%- if section.settings.chip_menu.links.size > 0 -%}
          {%- for link in section.settings.chip_menu.links -%}
            {%- assign dot_index = forloop.index0 | modulo: grounds.size -%}
            <a
              class="chip"
              href="{{ link.url }}"
              {% if link.active or link.current %}aria-current="page"{% endif %}
            >
              <span class="chip__dot" style="--swatch: var(--color-{{ grounds[dot_index] | strip }});" aria-hidden="true"></span>
              {{- link.title | escape -}}
            </a>
          {%- endfor -%}
        {%- else -%}
          {%- assign chip_filter = collection.filters | where: 'type', 'list' | first -%}
          {%- if chip_filter -%}
            {%- liquid
              assign any_active = false
              if chip_filter.active_values.size > 0
                assign any_active = true
              endif
              assign base_url = collection.url
              if collection.sort_by != blank
                assign base_url = base_url | append: '?sort_by=' | append: collection.sort_by
              endif
            -%}
            <a class="chip" href="{{ base_url }}" {% unless any_active %}aria-current="page"{% endunless %}>
              <span class="chip__dot" style="--swatch: var(--color-ink);" aria-hidden="true"></span>
              {{- 'sections.collection.all' | t -}}
            </a>
            {%- for value in chip_filter.values -%}
              {%- if value.count == 0 and value.active == false -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign dot_index = forloop.index0 | modulo: grounds.size
                assign chip_value = value.value | url_param_escape
                assign chip_url = collection.url | append: '?' | append: value.param_name | append: '=' | append: chip_value
                if collection.sort_by != blank
                  assign chip_url = chip_url | append: '&sort_by=' | append: collection.sort_by
                endif
              -%}
              <a class="chip" href="{{ chip_url }}" {% if value.active %}aria-current="page"{% endif %}>
                <span class="chip__dot" style="--swatch: var(--color-{{ grounds[dot_index] | strip }});" aria-hidden="true"></span>
                {{- value.label | escape -}}
              </a>
            {%- endfor -%}
          {%- endif -%}
        {%- endif -%}
      </nav>

      {%- if section.settings.show_sort -%}
        <form class="main-collection__sort" method="get" action="{{ collection.url }}" data-auto-submit>
          {%- for filter in collection.filters -%}
            {%- for value in filter.active_values -%}
              <input type="hidden" name="{{ value.param_name }}" value="{{ value.value }}">
            {%- endfor -%}
            {%- if filter.type == 'price_range' -%}
              {%- if filter.min_value.value -%}<input type="hidden" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency }}">{%- endif -%}
              {%- if filter.max_value.value -%}<input type="hidden" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency }}">{%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <label class="chip main-collection__sort-chip">
            <span>{{ 'sections.collection.sort' | t }}</span>
            <select name="sort_by" class="main-collection__select">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
            <span aria-hidden="true">↕</span>
          </label>
          <noscript><button type="submit" class="chip">{{ 'sections.collection.apply' | t }}</button></noscript>
        </form>
      {%- endif -%}
    </div>

    {%- if collection.products.size > 0 -%}
      <ul class="main-collection__grid" role="list">
        {%- liquid
          assign col = 0
          assign placed_tiles = ''
          assign product_total = collection.products.size
          assign trailing_note = false
          if paginate.current_page == 1
            for note in section.blocks
              if note.type == 'product_layout'
                continue
              endif
              if note.settings.position >= product_total
                assign trailing_note = true
              endif
            endfor
          endif
        -%}
        {%- for product in collection.products -%}
          {%- liquid
            assign layout = nil
            for candidate in layouts
              if candidate.settings.product.id == product.id
                assign layout = candidate
                break
              endif
            endfor
            assign span = product.metafields.custom.card_span.value | default: 1
            if layout
              assign span = layout.settings.span | plus: 0
            endif
            assign span = span | at_least: 1 | at_most: 3
            assign remaining = 3 | minus: col
            if span > remaining
              assign span = remaining
            endif
            if forloop.last and trailing_note == false
              assign span = remaining
            endif
            assign col = col | plus: span | modulo: 3

            case span
              when 2
                assign ratio = '3 / 2'
              when 3
                assign ratio = '9 / 4'
              else
                assign ratio = '3 / 4'
            endcase

            assign ground = product.metafields.custom.card_ground.value | strip | downcase
            if ground == blank
              assign ground_index = forloop.index0 | modulo: grounds.size
              assign ground = grounds[ground_index] | strip
            endif

            case span
              when 1
                assign card_sizes = '(min-width: 750px) 33vw, 50vw'
              when 2
                assign card_sizes = '(min-width: 750px) 66vw, 50vw'
              else
                assign card_sizes = '(min-width: 750px) 100vw, 50vw'
            endcase
            assign eager = false
            if forloop.index <= 3
              assign eager = true
            endif
          -%}
          <li class="main-collection__item" style="--span: {{ span }};" {% if layout %}{{ layout.shopify_attributes }}{% endif %}>
            {%- render 'product-card',
              product: product,
              image: layout.settings.image,
              video: layout.settings.video,
              ground: ground,
              ratio: ratio,
              show_tag: true,
              sizes: card_sizes,
              eager: eager,
              heading_tag: 'h2',
              class: 'product-card--upper'
            -%}
          </li>

          {%- liquid
            assign product_index = forloop.index
            assign product_is_last = forloop.last
          -%}
          {%- if paginate.current_page == 1 -%}
            {%- comment -%}
              Tiles due after this product are placed if they fit the space
              left in the row; a wide tile that doesn't fit waits for the next
              row, so it keeps its width and the grid stays gap-free. After
              the last product, each remaining tile fills the rest of its row.
            {%- endcomment -%}
            {%- for tile in section.blocks -%}
              {%- liquid
                if tile.type == 'product_layout'
                  continue
                endif
                assign tile_key = '|' | append: tile.id | append: '|'
                if placed_tiles contains tile_key
                  continue
                endif
                if tile.settings.position > product_index and product_is_last == false
                  continue
                endif
                assign tile_span = 1
                if tile.type == 'media'
                  assign tile_span = tile.settings.span | plus: 0
                endif
                assign tile_remaining = 3 | minus: col
                if product_is_last
                  assign tile_span = tile_remaining
                elsif tile_span > tile_remaining
                  continue
                endif
                assign col = col | plus: tile_span | modulo: 3
                assign placed_tiles = placed_tiles | append: tile_key
              -%}
              {%- render 'collection-tile', block: tile, span: tile_span -%}
            {%- endfor -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <div class="main-collection__empty">
        <p class="title-statement">{{ 'sections.collection.empty' | t }}</p>
        {%- liquid
          assign has_active_filter = false
          for filter in collection.filters
            if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank
              assign has_active_filter = true
            endif
          endfor
        -%}
        {%- if has_active_filter -%}
          <a class="button button--secondary" href="{{ collection.url }}">{{ 'sections.collection.clear' | t }}</a>
        {%- else -%}
          <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">{{ 'sections.not_found.button' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
{%- endpaginate -%}


{% stylesheet %}
  .main-collection__strip {
    position: sticky;
    top: 0;
    z-index: var(--z-header-strip);
    height: 0;
    margin-top: calc(-1 * var(--header-height) - var(--page-pad-top));
  }

  .main-collection__strip > div {
    height: var(--header-height);
    margin: 0 calc(-1 * var(--page-pad-x));
    background: var(--color-bg);
  }

  .main-collection .page-title {
    margin-top: calc(var(--header-height) + var(--page-pad-top));
    padding-bottom: 32px;
  }

  .main-collection__bar {
    position: sticky;
    top: var(--header-height);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 4px;
    padding: 10px 0;
    border-top: var(--section-border, var(--border));
    border-bottom: var(--border);
    background: var(--color-bg);
  }

  .main-collection__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .main-collection__chips .chip,
  .main-collection__sort-chip {
    gap: 7px;
    font-size: var(--text-label);
  }

  .chip__dot {
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 50%;
    background: var(--swatch);
  }

  .main-collection__sort-chip {
    position: relative;
  }

  .main-collection__select {
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    -webkit-appearance: none;
    appearance: none;
  }

  .main-collection__sort-chip:focus-within {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  @media (pointer: coarse) {
    .main-collection__select {
      padding-block: 14px;
      margin-block: -14px;
    }
  }

  .main-collection__select:focus-visible {
    outline: none;
  }

  /* The select is borderless, so its chip carries the focus ring. */
  .main-collection__sort-chip:has(.main-collection__select:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .main-collection__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .main-collection__item {
    grid-column: span var(--span, 1);
    min-width: 0;
  }

  .main-collection__note {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 220px;
    padding: 16px;
    border-radius: var(--radius-lg);
    background: var(--note-bg, var(--color-blue));
    color: var(--note-fg, var(--color-ink)); /* white only on ink: white on blue or red is below 4.5:1 */
  }

  .main-collection__media-tile {
    display: flex;
    flex-direction: column;
  }

  .main-collection__media-link {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .main-collection__media {
    flex: 1;
    min-height: 220px;
    aspect-ratio: auto;
  }

  .main-collection__note-text {
    font: 400 clamp(28px, 3.4vw, 52px) / 1.04 var(--font-display);
    letter-spacing: -0.02em;
  }

  .main-collection__empty {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding: 40px 0;
  }

  @media screen and (max-width: 749px) {
    .main-collection__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-auto-flow: row dense;
      gap: 20px var(--grid-gap);
    }

    .main-collection__item {
      grid-column: span 1;
    }

    .main-collection__item .product-card__media {
      --ratio: 3 / 4;
    }

    .main-collection__note,
    .main-collection__media-tile {
      grid-column: 1 / -1;
    }

    .main-collection__media {
      aspect-ratio: 3 / 2;
    }

    .main-collection .product-card__title {
      font-size: var(--text-card-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "show_border", "label": "Show top border", "default": true },
    { "type": "text", "id": "title", "label": "Title", "info": "Defaults to the collection title." },
    { "type": "richtext", "id": "intro", "label": "Intro", "info": "Defaults to the collection description." },
    {
      "type": "link_list",
      "id": "chip_menu",
      "label": "Filter chips menu",
      "info": "Optional. Collection links shown as chips (e.g. All, Editions, Zines, Books). Without a menu, the chips use the first list filter from Search & Discovery (e.g. Product type)."
    },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true },
    {
      "type": "text",
      "id": "grounds",
      "label": "Card colours",
      "info": "Comma-separated, repeating: blue, red, grey, ink, bg. A product's custom.card_ground metafield overrides this.",
      "default": "blue, grey, red, ink, blue, red"
    },
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Studio note",
      "settings": [
        { "type": "range", "id": "position", "label": "Show after product", "min": 1, "max": 24, "step": 1, "default": 3 },
        { "type": "text", "id": "label", "label": "Label", "default": "Studio note" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Blue is the first drum, always. Everything after has to argue with it." },
        {
          "type": "select",
          "id": "color",
          "label": "Colour",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "ink", "label": "Ink" }
          ],
          "default": "blue"
        }
      ]
    },
    {
      "type": "media",
      "name": "Media",
      "settings": [
        { "type": "range", "id": "position", "label": "Show after product", "min": 1, "max": 24, "step": 1, "default": 5 },
        {
          "type": "select",
          "id": "span",
          "label": "Width",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" },
            { "value": "3", "label": "3 columns" }
          ],
          "default": "2"
        },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted on a loop instead of the image; the image becomes its poster." },
        { "type": "text", "id": "caption", "label": "Label", "info": "Optional pill on the tile. Also used as the image's alt text." },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "color",
          "label": "Background",
          "options": [
            { "value": "grey", "label": "Grey" },
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "ink", "label": "Ink" }
          ],
          "default": "grey"
        }
      ]
    },
    {
      "type": "product_layout",
      "name": "Product layout",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "select",
          "id": "span",
          "label": "Width",
          "info": "Overrides the product's custom.card_span metafield in this collection grid.",
          "options": [
            { "value": "1", "label": "1 column" },
            { "value": "2", "label": "2 columns" },
            { "value": "3", "label": "3 columns" }
          ],
          "default": "2"
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Replaces the product's image on its card here." },
        { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted on a loop instead of the image." }
      ]
    }
  ]
}
{% endschema %}
