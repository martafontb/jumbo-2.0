{% comment %}
  Collection (baseline)
  Working product grid from collection.products with pagination. Phase 4
  replaces this with the designed PLP (mixed spans, studio notes, sticky
  filters and sort).
{% endcomment %}
{%- paginate collection.products by section.settings.per_page -%}
  <div class="page main-collection">
    {%- render 'page-title', title: collection.title, count: collection.products_count, intro: collection.description -%}
    {%- if collection.products.size > 0 -%}
      <ul class="card-grid" role="list">
        {%- for product in collection.products -%}
          <li>
            {%- assign price = product.price | money -%}
            {%- render 'card-basic', url: product.url, title: product.title, image: product.featured_media, meta: price, ratio: '3 / 4', placeholder: 'product-1' -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- render 'pagination', paginate: paginate -%}
    {%- else -%}
      <p class="title-statement">{{ 'sections.collection.empty' | t }}</p>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 24 }
  ]
}
{% endschema %}
