{% comment %}
  Overprint simulator ("Meet Jumbo")
  Pick an ink for each drum and nudge the misregistration slider to see two
  inks overprint (multiply blend). The figure is inline SVG. "Ink" blocks
  set the selectable inks; enter the real ink colours.
{% endcomment %}
{%- assign inks = section.blocks | where: 'type', 'ink' -%}
{%- if inks.size > 1 -%}
  {%- liquid
    assign ink_a = inks[0]
    assign ink_b = inks[1]
  -%}
  <overprint-simulator
    class="page overprint space-{{ section.settings.spacing }}"
    style="--ink-a: {{ ink_a.settings.color }}; --ink-b: {{ ink_b.settings.color }}; --reg: 3;"
    data-offset-label="{{ 'sections.overprint.offset' | t: amount: '[n]' | escape }}"
  >
    {%- render 'section-head', label: section.settings.label, color: 'red', caption: section.settings.caption -%}
    <div class="overprint__grid">
      <figure class="overprint__stage">
        <svg viewBox="0 0 300 200" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{ section.settings.figure_label | escape }}">
          <defs><pattern id="Halftone-{{ section.id }}" width="5" height="5" patternUnits="userSpaceOnUse"><circle cx="2.5" cy="2.5" r="1.3" fill="var(--color-white)"/></pattern></defs>
          <ellipse cx="150" cy="192" rx="110" ry="5" fill="var(--color-ink)" opacity=".12"/>
          <g class="overprint__layer overprint__layer--a">
            <ellipse cx="135" cy="118" rx="84" ry="52"/><rect x="66" y="150" width="28" height="40" rx="8"/><rect x="146" y="156" width="28" height="34" rx="8"/><circle cx="205" cy="82" r="38"/>
            <ellipse cx="135" cy="118" rx="84" ry="52" fill="url(#Halftone-{{ section.id }})" opacity=".35"/>
          </g>
          <g class="overprint__layer overprint__layer--b">
            <circle cx="168" cy="78" r="42"/><rect x="104" y="156" width="28" height="34" rx="8"/><rect x="186" y="150" width="28" height="40" rx="8"/>
            <path d="M228 96 q40 6 30 52 q-3 16 -18 12" fill="none" stroke="var(--ink-b)" stroke-width="17" stroke-linecap="round"/>
            <path d="M214 106 q22 8 30 -8" fill="none" stroke="var(--color-white)" stroke-width="5" stroke-linecap="round"/>
          </g>
          <circle cx="214" cy="72" r="4.5" fill="var(--color-ink)"/>
          <path d="M10 10h14M10 10v14M290 10h-14M290 10v14M10 190h14M10 190v-14M290 190h-14M290 190v-14" stroke="var(--color-ink)" stroke-width="1" fill="none"/>
        </svg>
        <figcaption class="pill pill--grey overprint__offset" data-offset aria-live="polite">{{ 'sections.overprint.offset' | t: amount: 3 }}</figcaption>
      </figure>
      <div class="overprint__controls">
        {%- for drum in (1..2) -%}
          <fieldset class="overprint__drum">
            <legend class="label label--sm">{{ 'sections.overprint.drum' | t: number: drum }}</legend>
            <div class="overprint__swatches">
              {%- for block in inks -%}
                {%- assign selected_index = drum | minus: 1 -%}
                <label class="overprint__swatch" style="--ink: {{ block.settings.color }};" title="{{ block.settings.name | escape }}" {{ block.shopify_attributes }}>
                  <input class="visually-hidden" type="radio" name="drum-{{ drum }}-{{ section.id }}" value="{{ block.settings.color }}" data-drum="{{ drum }}" data-name="{{ block.settings.name | escape }}" {% if forloop.index0 == selected_index %}checked{% endif %}>
                  <span class="visually-hidden">{{ block.settings.name | escape }}</span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
        <label class="label label--sm overprint__slider">
          {{- 'sections.overprint.misregistration' | t -}}
          <input type="range" min="0" max="12" step="1" value="3" data-reg>
        </label>
        <p class="overprint__names" data-names aria-live="polite">{{ ink_a.settings.name | escape }} + {{ ink_b.settings.name | escape }}</p>
      </div>
    </div>
  </overprint-simulator>
  <script src="{{ 'print-tools.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .overprint__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: 8px;
  }

  .overprint__stage {
    position: relative;
    grid-column: span 2;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    margin: 0;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
  }

  .overprint__stage svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .overprint__layer {
    mix-blend-mode: multiply;
  }

  .overprint__layer--a { fill: var(--ink-a); }

  .overprint__layer--b {
    fill: var(--ink-b);
    transform: translate(calc(var(--reg) * 1px), calc(var(--reg) * -0.6px));
    transition: transform 0.2s var(--ease-out-expo);
  }

  .overprint__offset {
    position: absolute;
    left: 10px;
    bottom: 10px;
    padding: 3px 12px;
  }

  .overprint__controls {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    margin-left: 12px;
  }

  .overprint__drum {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .overprint__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .overprint__swatch {
    width: 36px;
    height: 36px;
    border: 1px solid rgba(var(--color-ink-rgb), 0.25);
    border-radius: 50%;
    background: var(--ink);
    cursor: pointer;
  }

  .overprint__swatch:has(input:checked) {
    box-shadow: inset 0 0 0 4px var(--color-white);
    border-color: var(--color-ink);
  }

  .overprint__swatch:has(input:focus-visible) {
    outline: 2px solid var(--color-ink);
    outline-offset: 2px;
  }

  .overprint__slider {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .overprint__slider input {
    width: 100%;
    accent-color: var(--color-ink);
  }

  .overprint__names {
    font: 400 26px / 1.05 var(--font-display);
    letter-spacing: -0.02em;
  }

  @media screen and (max-width: 749px) {
    .overprint__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .overprint__stage {
      grid-column: auto;
    }

    .overprint__controls {
      margin: 12px 0 0;
    }

    .overprint__swatch {
      width: 44px;
      height: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Overprint simulator",
  "class": "section-overprint",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Fig. 2 — Meet Jumbo" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Pick two inks, nudge the registration" },
    { "type": "text", "id": "figure_label", "label": "Figure description", "info": "Read by screen readers.", "default": "Two ink layers of an illustrated elephant overprinting each other" },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "blocks": [
    {
      "type": "ink",
      "name": "Ink",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Blue" },
        { "type": "color", "id": "color", "label": "Ink colour", "default": "#22A8E1" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Overprint simulator",
      "blocks": [
        { "type": "ink", "settings": { "name": "Blue", "color": "#22A8E1" } },
        { "type": "ink", "settings": { "name": "Red", "color": "#EA5A46" } }
      ]
    }
  ]
}
{% endschema %}
