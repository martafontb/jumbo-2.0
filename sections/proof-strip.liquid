{% comment %}
  Proof strip
  A thin band under the first screen: "Since 2018 · 2 machines · 14 inks ·
  40 artists a year". The numbers come from Theme settings > Brand and studio >
  Studio facts, so they live in one place. A fact left empty is skipped, and the
  strip hides itself when all are empty. Nothing is invented: confirm each
  number with the client before publishing.
{% endcomment %}
{%- liquid
  assign facts = ''
  if settings.fact_since != blank
    assign fact = 'sections.proof.since' | t: year: settings.fact_since
    assign facts = facts | append: fact | append: '|'
  endif
  if settings.fact_machines != blank
    assign fact = 'sections.proof.machines' | t: count: settings.fact_machines
    assign facts = facts | append: fact | append: '|'
  endif
  if settings.fact_inks != blank
    assign fact = 'sections.proof.inks' | t: count: settings.fact_inks
    assign facts = facts | append: fact | append: '|'
  endif
  if settings.fact_artists != blank
    assign fact = 'sections.proof.artists' | t: count: settings.fact_artists
    assign facts = facts | append: fact | append: '|'
  endif
  assign fact_list = facts | split: '|'
-%}
{%- if fact_list.size > 0 -%}
  <section class="page proof-strip space-{{ section.settings.spacing }}" aria-label="{{ 'sections.proof.label' | t }}">
    <ul class="proof-strip__list" role="list" style="--strip-bg: var(--color-{{ section.settings.color }});">
      {%- for fact in fact_list -%}
        <li>{{ fact | escape }}</li>
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% stylesheet %}
  .proof-strip__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px 24px;
    margin: 0;
    padding: 12px 20px;
    border: var(--border);
    border-radius: var(--radius-md);
    background: var(--strip-bg, var(--color-grey));
    color: var(--color-ink);
    font: 400 var(--text-label) / 1.35 var(--font-label);
    letter-spacing: 0;
    list-style: none;
  }

  @media screen and (max-width: 749px) {
    .proof-strip__list {
      justify-content: flex-start;
      padding: 12px 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Proof strip",
  "class": "section-proof-strip",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "The numbers come from Theme settings > Brand and studio > Studio facts." },
    {
      "type": "select",
      "id": "color",
      "label": "Background",
      "options": [
        { "value": "grey", "label": "Grey" },
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "bg", "label": "Page background" }
      ],
      "default": "grey"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    }
  ],
  "presets": [{ "name": "Proof strip" }]
}
{% endschema %}
