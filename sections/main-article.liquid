{% comment %}
  Journal article
  Reading-progress bar, breadcrumb, balanced title, meta bar (kind pill,
  reading time, date, author, copy-link button), 21:9 hero, a sticky
  "Featured in this story" product (article metafield
  custom.featured_product) beside the text, and "Read next" cards from the
  same blog. Blockquotes in the article body render as the design's grey
  pull quotes.
{% endcomment %}
{%- liquid
  assign kind = article.tags.first | default: blog.title
  assign words = article.content | strip_html | split: ' ' | size
  assign minutes = words | divided_by: 200.0 | ceil | at_least: 1
  assign featured = article.metafields.custom.featured_product.value
-%}
<article-page class="page main-article">
  <div class="main-article__progress" aria-hidden="true"><span data-progress></span></div>

  <nav class="label label--sm main-article__crumb" aria-label="{{ 'products.breadcrumb' | t }}">
    <a class="tap-target" href="{{ blog.url }}">{{ blog.title | escape }}</a>
    {%- if article.tags.first != blank -%}<span aria-hidden="true"> / </span>{{ article.tags.first | escape }}{%- endif -%}
  </nav>
  <h1 class="main-article__title">{{ article.title | escape }}</h1>

  <div class="main-article__meta label label--sm">
    <span class="main-article__facts">
      {%- if kind != blank -%}<span class="pill pill--blue">{{ kind | escape }}</span>{%- endif -%}
      <span>{{ 'blogs.minutes_read' | t: count: minutes }}</span>
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time>
      {%- if section.settings.show_author and article.author != blank -%}
        <span>{{ 'blogs.words_by' | t: author: article.author }}</span>
      {%- endif -%}
    </span>
    <button type="button" class="chip main-article__copy" data-copy-link data-copied="{{ 'blogs.link_copied' | t | escape }}">{{ 'blogs.copy_link' | t }}</button>
  </div>

  {%- if article.image -%}
    <div class="media main-article__hero" style="--ratio: 21 / 9; --media-bg: var(--color-blue);">
      {%- render 'image', image: article.image, sizes: '100vw', alt_fallback: article.title, eager: true -%}
    </div>
  {%- endif -%}

  <div class="main-article__body">
    <aside class="main-article__aside">
      {%- if featured != blank -%}
        <div class="main-article__featured">
          <span class="pill pill--red">{{ section.settings.featured_label | escape }}</span>
          <a class="main-article__featured-link" href="{{ featured.url }}">
            <div class="media" style="--ratio: 1; --media-bg: var(--color-grey);">
              {%- render 'image', image: featured.featured_media, sizes: '(min-width: 750px) 33vw, 100vw', alt_fallback: featured.title -%}
            </div>
            <span class="main-article__featured-meta">
              <span class="title-card title-card--sm">{{ featured.title | escape }}</span>
              {%- render 'price', product: featured -%}
            </span>
          </a>
          {%- if featured.has_only_default_variant -%}
            {%- assign add_label = 'sections.shop_the_look.add' | t -%}
            {%- render 'add-to-cart-form', product: featured, label: add_label, class: 'button--full' -%}
          {%- else -%}
            <a class="button button--small button--full" href="{{ featured.url }}">{{ 'products.choose_options' | t }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </aside>

    <div class="main-article__text">
      {%- if article.excerpt != blank -%}
        <div class="main-article__dek">{{ article.excerpt }}</div>
      {%- endif -%}
      <div class="rte main-article__content">{{ article.content }}</div>
    </div>
  </div>

  {%- if section.settings.show_read_next and blog.articles_count > 1 -%}
    <div class="main-article__next space-large">
      {%- render 'section-head', label: section.settings.next_label, color: 'blue', caption: section.settings.next_caption -%}
      <ul class="main-article__next-grid" role="list">
        {%- assign shown = 0 -%}
        {%- assign palette = 'blue,red,grey' | split: ',' -%}
        {%- for other in blog.articles -%}
          {%- if other.id == article.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
          {%- assign ground_index = shown | modulo: 3 -%}
          {%- assign shown = shown | plus: 1 -%}
          <li>{%- render 'article-card', article: other, ground: palette[ground_index] -%}</li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</article-page>
<script src="{{ 'article.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .main-article__progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 95;
    height: 4px;
    pointer-events: none;
  }

  .main-article__progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-grey);
    transform: scaleX(var(--read, 0));
    transform-origin: left;
  }

  .main-article__crumb {
    padding-top: 16px;
  }

  .main-article__title {
    padding: 12px 0 18px;
    font: 500 clamp(44px, 8.4vw, 140px) / 0.88 var(--font-display);
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .main-article__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 0;
    border-top: var(--border);
    border-bottom: var(--border);
  }

  .main-article__facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 14px;
  }

  .main-article__copy {
    padding: 8px 14px;
  }

  .main-article__hero {
    margin-top: 4px;
    border-radius: 0;
  }

  .main-article__body {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .main-article__aside {
    padding-top: 20px;
  }

  .main-article__featured {
    position: sticky;
    top: 64px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .main-article__featured-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: 6px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .main-article__featured-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-top: 6px;
    border-top: var(--border);
  }

  .main-article__text {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 20px 0 0 28px;
  }

  .main-article__dek {
    font: 500 clamp(24px, 2.4vw, 38px) / 1.1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .main-article__content {
    font: 400 var(--text-article) / 1.6 var(--font-display);
    text-wrap: pretty;
  }

  .main-article__content > * {
    max-width: 60ch;
  }

  .main-article__content > * + * {
    margin-top: 22px;
  }

  .main-article__content h2,
  .main-article__content h3 {
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
  }

  .main-article__content h2 {
    font-size: clamp(28px, 3vw, 44px);
  }

  .main-article__content blockquote {
    max-width: none;
    margin: 34px 0;
    padding: 24px;
    border-radius: var(--radius-lg);
    background: var(--color-grey);
    font: 500 clamp(30px, 3.6vw, 56px) / 0.98 var(--font-display);
    letter-spacing: -0.05em;
  }

  .main-article__content img {
    width: 100%;
    max-width: none;
    border-radius: var(--radius-lg);
  }

  .main-article__next-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 8px 0 0;
    list-style: none;
  }

  @media screen and (max-width: 749px) {
    .main-article__body,
    .main-article__next-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .main-article__text {
      grid-column: auto;
      grid-row: 1;
      padding-left: 0;
    }

    .main-article__aside {
      grid-row: 2;
      padding-top: 40px;
    }

    .main-article__featured {
      position: static;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .main-article__progress {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article",
  "class": "section-main-article",
  "settings": [
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": true },
    { "type": "paragraph", "content": "Featured product: set the article metafield custom.featured_product (product reference)." },
    { "type": "text", "id": "featured_label", "label": "Featured product label", "default": "Featured in this story" },
    { "type": "checkbox", "id": "show_read_next", "label": "Show Read next", "default": true },
    { "type": "text", "id": "next_label", "label": "Read next label", "default": "Read next" },
    { "type": "text", "id": "next_caption", "label": "Read next caption", "default": "More from the journal" }
  ]
}
{% endschema %}
