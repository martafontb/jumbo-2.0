{% comment %}
  Newsletter popup
  Centred modal in the Overlays group. Opens once per visitor after a delay
  (dismissal is remembered in localStorage), and from any element with
  data-overlay-open="NewsletterPopup" (the footer "Newsletter" link).

  The form is Shopify's customer form, tagged "newsletter", and posts as a
  normal page load so Shopify's spam protection runs. After the post, the
  page reloads and the popup re-opens showing the success or error state.

  In the theme editor the popup never opens on its own; select the section
  to preview it.
{% endcomment %}
{%- liquid
  assign form_id = 'NewsletterPopupForm-' | append: section.id
  assign color = section.settings.image_color | default: 'blue'
-%}

{%- if section.settings.enabled -%}
<newsletter-popup
  data-delay="{{ section.settings.delay }}"
  {% unless section.settings.auto_open %}data-manual{% endunless %}
>
  <dialog class="overlay newsletter-popup" id="NewsletterPopup" aria-labelledby="NewsletterPopup-title">
    <div class="newsletter-popup__inner">
      <div class="media newsletter-popup__media" style="--media-bg: var(--color-{{ color }});">
        {%- if section.settings.show_elephant -%}
          {%- assign ear = 'red' -%}
              {%- if color == 'red' %}{% assign ear = 'blue' %}{% endif -%}
          {%- render 'popup-elephant', ears: ear -%}
            {%- else -%}
          {%- render 'image-or-video', video: section.settings.video, image: section.settings.image, sizes: '(min-width: 750px) 430px, 100vw', widths: '430, 640, 860, 1200', placeholder: 'lifestyle-1' -%}
        {%- endif -%}
      </div>

      <div class="newsletter-popup__body">
        <button type="button" class="icon-button newsletter-popup__close" data-overlay-close aria-label="{{ 'general.close' | t }}">
          <span aria-hidden="true">×</span>
        </button>
        {%- if section.settings.label != blank -%}
          <span class="pill pill--red">{{ section.settings.label | escape }}</span>
        {%- endif -%}

        {%- form 'customer', id: form_id, class: 'newsletter-popup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <h2 class="newsletter-popup__title" id="NewsletterPopup-title" data-posted>
              {{- section.settings.success_heading | escape -}}<span class="dot">.</span>
            </h2>
            <div class="newsletter-popup__fields">
              {%- if section.settings.success_text != blank -%}
                <p class="newsletter-popup__text">{{ section.settings.success_text | escape }}</p>
              {%- endif -%}
              <button type="button" class="button button--full" data-overlay-close>{{ section.settings.success_button | escape }}</button>
            </div>
          {%- else -%}
            <h2 class="newsletter-popup__title" id="NewsletterPopup-title">{{ section.settings.heading | escape }}</h2>
            <div class="newsletter-popup__fields">
              {%- if section.settings.text != blank -%}
                <p class="newsletter-popup__text">{{ section.settings.text | escape }}</p>
              {%- endif -%}
              <label class="visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.email' | t }}</label>
              <input
                class="field"
                type="email"
                name="contact[email]"
                id="{{ form_id }}-email"
                value="{{ form.email }}"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                required
                placeholder="{{ 'newsletter.placeholder' | t }}"
                {% if form.errors %}
                  aria-invalid="true" aria-describedby="{{ form_id }}-error" data-posted
                {% endif %}
              >
              {%- if form.errors -%}
                <p class="form-message form-message--error" id="{{ form_id }}-error">
                  {{- form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] -}}
                </p>
              {%- endif -%}
              <button type="submit" class="button button--full">{{ section.settings.button | escape }}</button>
              {%- if section.settings.dismiss != blank -%}
                <button type="button" class="link-mono newsletter-popup__dismiss" data-overlay-close>{{ section.settings.dismiss | escape }}</button>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </dialog>
</newsletter-popup>

<script src="{{ 'newsletter-popup.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .newsletter-popup {
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: min(860px, calc(100vw - 32px));
    max-height: calc(100dvh - 24px);
    overflow: auto;
    border: var(--border);
    border-radius: 24px;
  }

  .newsletter-popup__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
  }

  .newsletter-popup__media {
    aspect-ratio: auto;
    min-height: 340px;
    border-radius: 20px;
  }

  .newsletter-popup__body {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 16px 20px 12px 12px;
  }

  .newsletter-popup__close {
    position: absolute;
    top: 0;
    right: 0;
  }

  .newsletter-popup__form {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  .newsletter-popup__title {
    margin: 0;
    font: 500 clamp(40px, 5vw, 60px) / 0.9 var(--font-display);
    letter-spacing: -0.05em;
    text-wrap: balance;
  }

  .newsletter-popup__fields {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .newsletter-popup__text {
    margin: 0 0 4px;
    font: 400 15px / 1.35 var(--font-display);
  }

  .newsletter-popup__dismiss {
    align-self: center;
    min-height: 44px;
    padding: 0 12px;
  }

  @media (max-width: 749px) {
    .newsletter-popup__inner {
      grid-template-columns: minmax(0, 1fr);
    }

    .newsletter-popup__media {
      min-height: 200px;
    }

    .newsletter-popup__body {
      padding: 8px;
    }

    .newsletter-popup__close {
      width: 44px;
      height: 44px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter popup",
  "class": "section-newsletter-popup",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable popup", "default": true, "info": "When off, the popup never shows. Also hide the footer Newsletter link." },
    { "type": "checkbox", "id": "auto_open", "label": "Open automatically", "default": true, "info": "Opens once per visitor. Visitors who close it or subscribe don't see it again on that browser." },
    { "type": "range", "id": "delay", "label": "Delay before opening", "min": 1, "max": 30, "step": 1, "unit": "s", "default": 3 },
    { "type": "header", "content": "Image" },
    { "type": "checkbox", "id": "show_elephant", "label": "Show elephant instead of image", "default": true },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted on a loop instead of the image; the image becomes its poster." },
    { "type": "text", "id": "image_label", "label": "Image label", "default": "Next drop: 24 Oct" },
    {
      "type": "select",
      "id": "image_color",
      "label": "Image background and label colour",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" }
      ],
      "default": "blue"
    },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "label", "label": "Label", "default": "Studio letter" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the next drop first." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "New editions, zines and workshop dates, once a month. Subscribers see every run 24 hours early." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Subscribe →" },
    { "type": "text", "id": "dismiss", "label": "Dismiss link label", "default": "No thanks" },
    { "type": "header", "content": "After subscribing" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "You're on the list" },
    { "type": "textarea", "id": "success_text", "label": "Text", "default": "We'll write before the next drop. Nothing else." },
    { "type": "text", "id": "success_button", "label": "Button label", "default": "Keep browsing →" }
  ],
  "presets": [{ "name": "Newsletter popup" }],
  "enabled_on": { "groups": ["custom.overlay"] }
}
{% endschema %}
