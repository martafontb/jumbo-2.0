{% comment %}
  Shipping pill
  A pill fixed to the bottom of the screen with the shipping message and a
  close button. Closing it hides it for the rest of the visit (sessionStorage).
  Lives in the Overlays group.

  Text: the "Text" setting, or, when empty, "Free shipping over [amount]" built
  from Theme settings > Cart > Free shipping threshold. Hidden when both are
  empty. On phones it hides while the product page's sticky add-to-cart bar
  is showing, so the two never overlap.
{% endcomment %}
{%- liquid
  assign threshold = settings.free_shipping_threshold | default: 0 | times: 100
  assign pill_text = section.settings.text
  if pill_text == blank and threshold > 0
    assign threshold_money = threshold | money_without_trailing_zeros
    assign pill_text = 'sections.announcement.free_shipping' | t: amount: threshold_money
  endif
-%}
{%- if section.settings.enabled and pill_text != blank -%}
  <shipping-pill class="shipping-pill" data-key="{{ section.id }}" {% if request.design_mode %}data-design-mode{% endif %} hidden>
    {%- if section.settings.link != blank -%}
      <a class="shipping-pill__text" href="{{ section.settings.link }}">{{ pill_text | escape }}</a>
    {%- else -%}
      <p class="shipping-pill__text">{{ pill_text | escape }}</p>
    {%- endif -%}
    <button type="button" class="shipping-pill__close" data-shipping-pill-close aria-label="{{ 'sections.shipping_pill.close' | t }}">
      <span aria-hidden="true">×</span>
    </button>
  </shipping-pill>
  <script src="{{ 'shipping-pill.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .shipping-pill {
    position: fixed;
    bottom: 16px;
    left: 50%;
    z-index: var(--z-header-strip);
    display: flex;
    align-items: center;
    gap: 4px;
    max-width: calc(100vw - 32px);
    padding: 4px 4px 4px 16px;
    translate: -50% 0;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: var(--color-grey);
    color: var(--color-ink);
    font: 400 var(--text-label) / 1.3 var(--font-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .shipping-pill[hidden] {
    display: none;
  }

  .shipping-pill__text {
    margin: 0;
    color: inherit;
    text-decoration: none;
  }

  .shipping-pill__close {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    font-size: 18px;
    line-height: 1;
    transition: background-color 0.15s;
  }

  .shipping-pill__close:hover {
    background: var(--color-blue);
  }

  @media (pointer: coarse) {
    .shipping-pill__close {
      width: 44px;
      height: 44px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shipping-pill__close {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    body:has(.sticky-buy:not([hidden])) .shipping-pill {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shipping pill",
  "class": "section-shipping-pill",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show the pill", "default": true },
    { "type": "text", "id": "text", "label": "Text", "info": "Leave empty to show 'Free shipping over [amount]' from Theme settings > Cart." },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "enabled_on": { "groups": ["custom.overlay"] }
}
{% endschema %}
