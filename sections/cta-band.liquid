{% comment %}
  CTA band
  Full-width grey band with a big line of text across two columns and a
  button in the third (e.g. "Ready? Send us the file.").
{% endcomment %}
<section class="page cta-band space-{{ section.settings.spacing }}">
  <div class="cta-band__inner" style="--band-bg: var(--color-{{ section.settings.color }});">
    {%- if section.settings.text != blank -%}
      <p class="cta-band__text">{{ section.settings.text | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button cta-band__button" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .cta-band__inner {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: end;
    padding: clamp(20px, 3vw, 48px);
    background: var(--band-bg, var(--color-grey));
  }

  .cta-band__text {
    grid-column: span 2;
    font: 500 clamp(36px, 5vw, 60px) / 0.92 var(--font-display);
    letter-spacing: -0.05em;
  }

  .cta-band__button {
    border-radius: 0;
  }

  @media screen and (max-width: 749px) {
    .cta-band__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .cta-band__text {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "CTA band",
  "class": "section-cta-band",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Ready? Send us the file." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the price guide →" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "color",
      "label": "Background",
      "options": [
        { "value": "grey", "label": "Grey" },
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" }
      ],
      "default": "grey"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "presets": [{ "name": "CTA band" }]
}
{% endschema %}
