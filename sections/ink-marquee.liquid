{% comment %}
  Ink marquee
  A continuously scrolling row of rounded colour blocks, one per ink, each
  labelled with the ink's name and an optional code (e.g. a Pantone or hex
  reference). Each ink is a block. With "Overprint", blocks overlap and
  their colour layers multiply, so neighbouring inks mix where they cross,
  like a risograph overprint; "Misregistration" nudges blocks up and down.
  Shape "Worm" turns each run of inks into a wiggling worm of overlapping
  round segments (they overprint too), with eyes on the head; ink names
  appear on hover (always on touch screens and under reduced motion) and
  are always available to screen readers. The row pauses on hover and keyboard
  focus and has a pause button (WCAG 2.2.2). Under reduced motion it doesn't
  move; it becomes a row you can scroll.

  The list is printed twice so the loop is seamless; the copy is hidden from
  assistive technology.
{% endcomment %}
{%- render 'section-border', section: section -%}
{%- liquid
  assign inks = section.blocks | where: 'type', 'ink'
  case section.settings.size
    when 'small'
      assign block_width = '160px'
    when 'large'
      assign block_width = '320px'
    else
      assign block_width = '240px'
  endcase
  assign region_label = section.settings.label
  if region_label == blank
    assign region_label = 'sections.ink_marquee.label' | t
  endif
-%}
{%- liquid
  assign worm = false
  if section.settings.shape == 'worm'
    assign worm = true
  endif
-%}
{%- if inks.size > 0 -%}
  <ink-marquee
    class="ink-marquee space-{{ section.settings.spacing }}{% if section.settings.direction == 'right' %} ink-marquee--reverse{% endif %}{% if worm %} ink-marquee--worm{% else %}{% if section.settings.overprint > 0 %} ink-marquee--overprint{% endif %}{% if section.settings.misregister %} ink-marquee--misregister{% endif %}{% endif %}"
    style="--marquee-duration: {{ section.settings.speed | times: inks.size }}s; --ink-block: {{ block_width }}; --overlap: {{ section.settings.overprint | divided_by: 100.0 }};"
    data-play-label="{{ 'sections.ink_marquee.play' | t | escape }}"
    data-pause-label="{{ 'sections.ink_marquee.pause' | t | escape }}"
  >
    {%- if section.settings.label != blank or section.settings.caption != blank -%}
      <div class="page ink-marquee__head">
        {%- render 'section-head', label: section.settings.label, color: section.settings.label_color, caption: section.settings.caption -%}
      </div>
    {%- endif -%}

    <div class="ink-marquee__viewport" tabindex="0" role="region" aria-label="{{ region_label | escape }}">
      <div class="ink-marquee__track">
        {%- for copy in (1..2) -%}
          <ul class="ink-marquee__group" role="list" {% if copy == 2 %}aria-hidden="true" inert{% endif %}>
            {%- for block in inks -%}
              <li class="ink-marquee__ink" style="--ink: {{ block.settings.color }}; --i: {{ forloop.index0 }};" {% if copy == 1 %}{{ block.shopify_attributes }}{% endif %}>
                <span class="pill pill--bg ink-marquee__name">{{ block.settings.name | escape }}</span>
                {%- if block.settings.code != blank -%}
                  <span class="pill pill--bg ink-marquee__code">{{ block.settings.code | escape }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>

    <div class="page ink-marquee__controls">
      <button type="button" class="icon-button ink-marquee__toggle" data-marquee-toggle aria-label="{{ 'sections.ink_marquee.pause' | t }}">
        <span data-icon-pause aria-hidden="true">❚❚</span>
        <span data-icon-play aria-hidden="true" hidden>▶</span>
      </button>
    </div>
  </ink-marquee>

  <script src="{{ 'ink-marquee.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .ink-marquee__head {
    margin-bottom: 16px;
  }

  .ink-marquee__viewport {
    overflow: hidden;
  }

  .ink-marquee__viewport:focus-visible {
    outline-offset: -2px;
  }

  .ink-marquee__track {
    display: flex;
    width: max-content;
    animation: ink-marquee var(--marquee-duration, 40s) linear infinite;
  }

  .ink-marquee--reverse .ink-marquee__track {
    animation-direction: reverse;
  }

  .ink-marquee:hover .ink-marquee__track,
  .ink-marquee:focus-within .ink-marquee__track,
  .ink-marquee.is-paused .ink-marquee__track,
  .ink-marquee.is-paused .ink-marquee__ink::before,
  .ink-marquee.is-paused .ink-marquee__ink::after,
  .ink-marquee.is-paused .ink-marquee__ink .pill {
    animation-play-state: paused;
  }

  .ink-marquee__group {
    display: flex;
    gap: var(--grid-gap);
    margin: 0;
    padding: 0 var(--grid-gap) 0 0;
    list-style: none;
  }

  .ink-marquee__ink {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    width: var(--ink-block);
    aspect-ratio: 3 / 4;
    padding: 8px;
    border-radius: var(--radius-lg);
    background: var(--ink);
  }

  /* Overprint: blocks overlap; the colour sits on a multiplied layer so the
     overlaps mix, while the labels stay on top, unblended. Each group ends
     with the same negative overlap, so the -50% loop stays seamless. */
  .ink-marquee--overprint .ink-marquee__group {
    gap: 0;
    margin-right: calc(var(--ink-block) * var(--overlap) * -1);
    padding: 0;
  }

  .ink-marquee--overprint .ink-marquee__ink {
    background: none;
  }

  .ink-marquee--overprint .ink-marquee__ink + .ink-marquee__ink {
    margin-left: calc(var(--ink-block) * var(--overlap) * -1);
  }

  .ink-marquee--overprint .ink-marquee__ink::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ink);
    mix-blend-mode: multiply;
  }

  .ink-marquee--overprint .ink-marquee__ink .pill {
    position: relative;
    z-index: 1;
  }

  .ink-marquee--misregister .ink-marquee__group {
    padding-block: 10px;
  }

  /* `top`, not transform: a transform would isolate each block's blend. */
  .ink-marquee--misregister .ink-marquee__ink:nth-child(3n + 1) { top: -6px; }
  .ink-marquee--misregister .ink-marquee__ink:nth-child(3n + 2) { top: 5px; }
  .ink-marquee--misregister .ink-marquee__ink:nth-child(4n) { top: -2px; }

  /* Worm: round segments that overlap and multiply, a wave running down the
     body (each segment's colour layer and label move; the <li> itself never
     transforms, so the blends still mix), and eyes on the leading segment. */
  .ink-marquee--worm {
    --seg: calc(var(--ink-block) * 0.6);
    --amp: calc(var(--seg) * 0.14);
  }

  .ink-marquee--worm .ink-marquee__group {
    gap: 0;
    align-items: center;
    margin-right: var(--seg);
    padding: calc(var(--amp) + 8px) 0;
  }

  .ink-marquee--worm .ink-marquee__ink {
    justify-content: center;
    align-items: center;
    width: var(--seg);
    aspect-ratio: 1;
    padding: 0;
    border-radius: 50%;
    background: none;
  }

  .ink-marquee--worm .ink-marquee__ink + .ink-marquee__ink {
    margin-left: calc(var(--seg) * -0.4);
  }

  .ink-marquee--worm .ink-marquee__ink:last-child {
    width: calc(var(--seg) * 0.8);
  }

  .ink-marquee--worm.ink-marquee--reverse .ink-marquee__ink:last-child {
    width: var(--seg);
  }

  .ink-marquee--worm.ink-marquee--reverse .ink-marquee__ink:first-child {
    width: calc(var(--seg) * 0.8);
  }

  .ink-marquee--worm .ink-marquee__ink::before,
  .ink-marquee--worm .ink-marquee__ink::after,
  .ink-marquee--worm .ink-marquee__ink .pill {
    animation: ink-worm 1.4s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.2s);
  }

  .ink-marquee--worm .ink-marquee__ink::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ink);
    mix-blend-mode: multiply;
  }

  /* Eyes on the head: the first segment, or the last when moving right. */
  .ink-marquee--worm .ink-marquee__ink:first-child::after,
  .ink-marquee--worm.ink-marquee--reverse .ink-marquee__ink:last-child::after {
    content: '';
    position: absolute;
    top: 26%;
    left: 14%;
    z-index: 2;
    width: 44%;
    height: 22%;
    background:
      radial-gradient(circle at 30% 55%, var(--color-ink) 0 14%, transparent 15%),
      radial-gradient(circle at 78% 55%, var(--color-ink) 0 14%, transparent 15%),
      radial-gradient(circle at 25% 50%, var(--color-white) 0 27%, transparent 28%),
      radial-gradient(circle at 75% 50%, var(--color-white) 0 27%, transparent 28%);
  }

  .ink-marquee--worm.ink-marquee--reverse .ink-marquee__ink:first-child::after {
    content: none;
  }

  .ink-marquee--worm.ink-marquee--reverse .ink-marquee__ink:last-child::after {
    left: auto;
    right: 14%;
  }

  .ink-marquee--worm .ink-marquee__ink .pill {
    position: absolute;
    bottom: calc(100% + 4px);
    left: 50%;
    z-index: 3;
    margin-left: -50%;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  .ink-marquee--worm .ink-marquee__code {
    display: none;
  }

  .ink-marquee--worm .ink-marquee__ink:hover .ink-marquee__name {
    opacity: 1;
  }

  /* No hover on touch screens (and no wiggle under reduced motion): names
     stay visible, alternating above and below so neighbours don't collide. */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .ink-marquee--worm .ink-marquee__group {
      padding-block: calc(var(--amp) + 36px);
    }

    .ink-marquee--worm .ink-marquee__ink .ink-marquee__name {
      opacity: 1;
    }

    .ink-marquee--worm .ink-marquee__ink:nth-child(even) .pill {
      top: calc(100% + 4px);
      bottom: auto;
    }
  }

  @keyframes ink-worm {
    from { transform: translateY(calc(var(--amp) * -1)); }
    to { transform: translateY(var(--amp)); }
  }

  .ink-marquee__controls {
    display: flex;
    justify-content: flex-end;
    padding-top: 8px;
  }

  @keyframes ink-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* No movement: a row the visitor scrolls, the copy and the button hidden. */
  @media (prefers-reduced-motion: reduce) {
    .ink-marquee__viewport {
      overflow-x: auto;
    }

    .ink-marquee__track,
    .ink-marquee--worm .ink-marquee__ink::before,
    .ink-marquee--worm .ink-marquee__ink::after,
    .ink-marquee--worm .ink-marquee__ink .pill {
      animation: none;
    }

    .ink-marquee__group[aria-hidden='true'],
    .ink-marquee__controls {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ink-marquee__ink {
      width: calc(var(--ink-block) * 0.7);
    }

    .ink-marquee--worm {
      --seg: calc(var(--ink-block) * 0.42);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ink marquee",
  "class": "section-ink-marquee",
  "tag": "section",
  "max_blocks": 30,
  "settings": [
    { "type": "checkbox", "id": "show_border", "label": "Show top border", "default": true },
    { "type": "text", "id": "label", "label": "Label", "default": "Our inks" },
    {
      "type": "select",
      "id": "label_color",
      "label": "Label colour",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" }
      ],
      "default": "red"
    },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Every colour we print" },
    {
      "type": "select",
      "id": "size",
      "label": "Block size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "shape",
      "label": "Shape",
      "options": [
        { "value": "blocks", "label": "Blocks" },
        { "value": "worm", "label": "Worm" }
      ],
      "default": "worm",
      "info": "Worm: each run of inks becomes a wiggling worm of round segments; ink names show on hover."
    },
    { "type": "range", "id": "overprint", "label": "Overprint", "info": "Blocks only. How much neighbouring inks overlap and mix. 0 turns it off.", "min": 0, "max": 40, "step": 5, "unit": "%", "default": 25 },
    { "type": "checkbox", "id": "misregister", "label": "Misregistration", "info": "Blocks only. Nudges blocks slightly up and down, like a hand-fed print run.", "default": true },
    { "type": "range", "id": "speed", "label": "Seconds per ink", "info": "Higher is slower.", "min": 2, "max": 12, "step": 1, "unit": "s", "default": 5 },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Space below",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "blocks": [
    {
      "type": "ink",
      "name": "Ink",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Jumbo Red" },
        { "type": "color", "id": "color", "label": "Colour", "default": "#EA5A46" },
        { "type": "text", "id": "code", "label": "Code", "info": "Optional, e.g. a Pantone or hex reference." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ink marquee",
      "blocks": [
        { "type": "ink", "settings": { "name": "Jumbo Red", "color": "#EA5A46" } },
        { "type": "ink", "settings": { "name": "Jumbo Yellow", "color": "#FFE800" } },
        { "type": "ink", "settings": { "name": "Jumbo Green", "color": "#00A95C" } },
        { "type": "ink", "settings": { "name": "Jumbo Blue", "color": "#0078BF" } },
        { "type": "ink", "settings": { "name": "Jumbo Aqua", "color": "#5EC8E5" } },
        { "type": "ink", "settings": { "name": "Jumbo Purple", "color": "#765BA7" } },
        { "type": "ink", "settings": { "name": "Jumbo Fluo-Green", "color": "#44D62C" } }
      ]
    }
  ]
}
{% endschema %}
