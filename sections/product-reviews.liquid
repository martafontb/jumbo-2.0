{% comment %}
  Product reviews
  Reviews come from the Shop app. The left column shows the average rating
  and count from the standard reviews.rating / reviews.rating_count
  metafields (when the app fills them). The written reviews can't be read
  from Liquid: they come from the reviews app's block (Add block > Apps).
  The theme editor shows a prompt until one is added. The section is hidden
  until it has a rating or an app block.
{% endcomment %}
{%- render 'section-border', section: section -%}
{%- liquid
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign apps = section.blocks | where: 'type', '@app'
-%}
{%- if rating != blank or apps.size > 0 -%}
  <section class="page product-reviews space-{{ section.settings.spacing }}" id="Reviews">
    {%- capture caption -%}{%- if rating_count > 0 -%}{{ 'products.reviews.count' | t: count: rating_count }}{%- endif -%}{%- endcapture -%}
    {%- render 'section-head', label: section.settings.label, color: 'blue', caption: caption -%}
    <div class="product-reviews__grid">
      <div class="product-reviews__summary">
        {%- if rating != blank -%}
          <p class="product-reviews__score">{{ rating.rating | round: 1 }}</p>
          {%- render 'stars', rating: rating.rating, max: rating.scale_max, class: 'product-reviews__stars' -%}
        {%- endif -%}
      </div>
      {%- if apps.size > 0 -%}
        <div class="product-reviews__list">
          {%- for block in apps -%}
            {% render block %}
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="product-reviews__list product-reviews__hint label">{{ 'products.reviews.add_app' | t }}</p>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <p class="page label product-reviews__empty">{{ 'products.reviews.empty' | t }}</p>
{%- endif -%}

{% stylesheet %}
  .product-reviews__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    padding-top: 8px;
  }

  .product-reviews__summary {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .product-reviews__score {
    font: 500 clamp(80px, 12vw, 200px) / 0.85 var(--font-display);
    letter-spacing: -0.05em;
  }

  .product-reviews__stars {
    font-size: 22px;
  }

  .product-reviews__hint {
    padding: 16px;
    border: 1px dashed var(--color-ink);
    border-radius: var(--radius-lg);
  }

  .product-reviews__list {
    grid-column: span 2;
    min-width: 0;
    margin-top: -8px;
  }

  /* Judge.me widget overrides. The app injects its own markup, so these hook
     its documented jdgm-* classes. The theme's left column already shows the
     average and stars, so the widget's own summary is hidden. */
  .product-reviews__list .jdgm-rev-widg {
    padding: 0;
    border: 0;
    font-family: inherit;
    color: var(--color-ink);
  }

  .product-reviews__list .jdgm-rev-widg__title,
  .product-reviews__list .jdgm-rev-widg__summary-inner,
  .product-reviews__list .jdgm-rev-widg__summary-average,
  .product-reviews__list .jdgm-rev-widg__summary-text {
    display: none;
  }

  .product-reviews__list .jdgm-rev-widg__summary {
    margin: 0;
    padding: 0;
    border: 0;
  }

  .product-reviews__list .jdgm-star,
  .product-reviews__list .jdgm-prev-badge__stars {
    color: var(--color-ink);
    font-size: 16px;
  }

  .product-reviews__list .jdgm-write-rev-link,
  .product-reviews__list .jdgm-write-rev-link:hover {
    padding: 8px 16px;
    border: 2px solid var(--color-ink);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: 14px;
  }

  .product-reviews__list .jdgm-write-rev-link:hover {
    background: var(--color-ink);
    color: var(--color-bg);
  }

  /* Judge.me revamped widget (jm-* classes). Matches the design's review rows:
     150px meta column (name, verified pill, date) beside stars + body.
     Inline custom properties on the widget set sizes, so only properties are
     overridden here, scoped by .jm-review-widget for specificity. */
  .product-reviews__list .jm-review-widget {
    max-width: none;
    font-family: var(--font-display);
    color: var(--color-ink);
  }

  .product-reviews__list .jm-review-widget .jm-text {
    font-family: inherit;
    color: inherit;
  }

  /* Title and average are already shown in the left column */
  .product-reviews__list .jm-review-widget-minimal-header__title,
  .product-reviews__list .jm-average-rating-display {
    display: none;
  }

  .product-reviews__list .jm-review-widget__header {
    padding-bottom: 16px;
  }

  /* Buttons: .button / .button--secondary look */
  .product-reviews__list .jm-review-widget .jm-button {
    min-height: 36px;
    padding: 10px 18px;
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-pill);
    font: 400 var(--text-label-sm) / 1 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }

  .product-reviews__list .jm-review-widget .jm-button--primary {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .product-reviews__list .jm-review-widget .jm-button--primary:hover {
    background: var(--color-red);
    border-color: var(--color-red);
    color: var(--color-ink);
  }

  .product-reviews__list .jm-review-widget .jm-button--secondary {
    background: transparent;
    color: var(--color-ink);
  }

  .product-reviews__list .jm-review-widget .jm-button--secondary:hover {
    background: var(--color-grey);
  }

  .product-reviews__list .jm-sort-filter__select {
    border: var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: 400 var(--text-label-sm) / 1.35 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  /* Review rows */
  .product-reviews__list .jm-review-item {
    padding-block: 24px;
    border-top: var(--border);
    background: transparent;
  }

  .product-reviews__list .jm-review-item__content {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    column-gap: 24px;
    row-gap: 12px;
    width: 100%;
  }

  .product-reviews__list .jm-reviewer-info {
    grid-column: 1;
    grid-row: 1 / span 2;
    align-self: start;
  }

  .product-reviews__list .jm-review-item__content > :first-child {
    grid-column: 2;
    grid-row: 1;
  }

  .product-reviews__list .jm-review-content {
    grid-column: 2;
    grid-row: 2;
  }

  .product-reviews__list .jm-reviewer-avatar {
    display: none;
  }

  /* Top-align the meta column with the stars: drop any top offset and the
     centred alignment the widget sets on the clusters/stack. */
  .product-reviews__list .jm-review-widget .jm-reviewer-info,
  .product-reviews__list .jm-review-widget .jm-reviewer-info__details {
    align-items: flex-start;
    align-content: flex-start;
    margin: 0;
    padding: 0;
  }

  .product-reviews__list .jm-review-widget .jm-reviewer-info__details > .jm-cluster {
    align-items: flex-start;
    line-height: 1.2;
  }

  .product-reviews__list .jm-review-widget .jm-reviewer-info__name {
    line-height: 1.2;
  }

  .product-reviews__list .jm-review-widget .jm-star-rating,
  .product-reviews__list .jm-review-widget .jm-star-rating .jm-cluster {
    margin: 0;
    padding: 0;
    line-height: 1.2;
    align-items: flex-start;
  }

  .product-reviews__list .jm-review-widget .jm-reviewer-info__name {
    font-size: var(--text-body);
    font-weight: 500; /* beats the inline --text-weight (bold) via the property itself */
  }

  .product-reviews__list .jm-verified-buyer-badge__text,
  .product-reviews__list .jm-reviewer-info .jm-text:not(.jm-reviewer-info__name) {
    font-family: var(--font-mono);
    font-size: var(--text-label-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .product-reviews__list .jm-star-rating {
    font-size: 8px; /* the stars are 1.5em of this: 12px */
    color: var(--color-ink);
  }

  .product-reviews__list .jm-review-content__body {
    font-size: var(--text-body);
    line-height: var(--leading-body);
  }

  .product-reviews__empty {
    padding-block: 20px;
  }

  @media screen and (max-width: 749px) {
    .product-reviews__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-reviews__list {
      grid-column: auto;
      margin-top: 0;
    }

    .product-reviews__list .jm-review-item__content {
      grid-template-columns: minmax(0, 1fr);
    }

    .product-reviews__list .jm-reviewer-info,
    .product-reviews__list .jm-review-item__content > :first-child,
    .product-reviews__list .jm-review-content {
      grid-column: 1;
      grid-row: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product reviews",
  "class": "section-product-reviews",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_border", "label": "Show top border", "default": true },
    { "type": "paragraph", "content": "Add the Shop app's reviews block below. The average rating shows when the app fills the reviews.rating metafield." },
    { "type": "text", "id": "label", "label": "Label", "default": "Reviews" },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "blocks": [{ "type": "@app" }],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Product reviews" }]
}
{% endschema %}
