{% comment %}
  Shop the look ("Shop the studio")
  A 3:2 lifestyle image with numbered hotspots. Each "Hotspot" block picks a
  product and a position (percent from left / top). Clicking a dot opens a
  small card with the title, price and "Add to cart". The list on the right
  mirrors the hotspots and opens the same cards.
{% endcomment %}
{%- liquid
  assign hotspots = section.blocks | where: 'type', 'hotspot'
  assign placeholder_title = 'products.placeholder_title' | t
-%}
<section class="page shop-look space-{{ section.settings.spacing }}">
  {%- render 'section-head', label: section.settings.label, color: section.settings.label_color, caption: section.settings.caption -%}
  <shop-the-look class="shop-look__grid">
    <div class="shop-look__stage">
      <div class="media shop-look__image" style="--ratio: 3 / 2;">
        {%- render 'image', image: section.settings.image, sizes: '(min-width: 750px) 66vw, 100vw', alt: section.settings.image_alt, placeholder: 'lifestyle-1' -%}
      </div>
      {%- for block in hotspots -%}
        {%- liquid
          assign product = block.settings.product
          assign popover_side = 'right'
          if block.settings.x > 55
            assign popover_side = 'left'
          endif
          assign popover_vert = 'below'
          if block.settings.y > 60
            assign popover_vert = 'above'
          endif
        -%}
        <div
          class="shop-look__spot"
          style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%;"
          data-spot="{{ forloop.index0 }}"
          {{ block.shopify_attributes }}
        >
          <button
            type="button"
            class="shop-look__dot"
            aria-expanded="false"
            aria-controls="Hotspot-{{ block.id }}"
            aria-label="{{ product.title | default: block.settings.title | default: placeholder_title | escape }}"
            data-spot-trigger="{{ forloop.index0 }}"
          >
            {{- forloop.index -}}
          </button>
          <div class="shop-look__card shop-look__card--{{ popover_side }} shop-look__card--{{ popover_vert }}" id="Hotspot-{{ block.id }}" hidden>
            <div class="shop-look__card-head">
              <a class="shop-look__card-title" href="{{ product.url | default: '#' }}">{{ product.title | default: block.settings.title | default: placeholder_title | escape }}</a>
              {%- if product != blank -%}{%- render 'price', product: product -%}{%- endif -%}
            </div>
            {%- if product != blank -%}
              {%- assign add_label = 'sections.shop_the_look.add' | t -%}
              {%- render 'add-to-cart-form', product: product, label: add_label, class: 'button--full' -%}
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="shop-look__list">
      {%- if section.settings.heading != blank -%}
        <h3 class="shop-look__heading">{{ section.settings.heading | escape }}<span class="dot">.</span></h3>
      {%- endif -%}
      <ol class="shop-look__items" role="list">
        {%- for block in hotspots -%}
          {%- assign product = block.settings.product -%}
          <li>
            <button type="button" class="shop-look__item tap-target" data-spot-trigger="{{ forloop.index0 }}" style="--item-color: var(--color-{{ block.settings.color }});">
              <span class="shop-look__item-name">
                <span class="label label--sm">{{ forloop.index | prepend: '0' }}</span>
                <span class="shop-look__item-title">{{ product.title | default: block.settings.title | default: placeholder_title | escape }}</span>
              </span>
              {%- if product != blank -%}{%- render 'price', product: product -%}{%- endif -%}
            </button>
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </shop-the-look>
</section>
<script src="{{ 'shop-the-look.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .shop-look__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
  }

  .shop-look__stage {
    position: relative;
    grid-column: span 2;
    margin-top: 8px;
  }

  .shop-look__spot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    z-index: 2;
  }

  .shop-look__spot.is-open {
    z-index: 6;
  }

  .shop-look__dot {
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    padding: 0;
    border: 2px solid var(--color-ink);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-ink);
    font: 400 14px / 1 var(--font-mono);
  }

  .shop-look__dot:hover,
  .shop-look__dot[aria-expanded='true'] {
    background: var(--color-grey);
  }

  /* Bigger hit area on touch without changing the dot. */
  @media (pointer: coarse) {
    .shop-look__dot {
      position: relative;
    }

    .shop-look__dot::after {
      content: '';
      position: absolute;
      inset: -9px;
    }
  }

  .shop-look__card {
    position: absolute;
    width: 220px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 10px;
    border: var(--border);
    background: var(--color-bg);
    animation: fade 0.2s both;
  }

  .shop-look__card--right { left: -15px; }
  .shop-look__card--left { left: -210px; }
  .shop-look__card--below { top: 18px; }
  .shop-look__card--above { bottom: 18px; }

  .shop-look__card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
  }

  .shop-look__card-title {
    font: 400 22px / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .shop-look__list {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
    padding-top: 8px;
    border-top: var(--border);
  }

  .shop-look__heading {
    margin: 8px 0 10px;
    font: 400 clamp(40px, 4.6vw, 76px) / 0.9 var(--font-display);
    letter-spacing: -0.05em;
  }

  .shop-look__items {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .shop-look__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-top: var(--border);
    background: transparent;
    color: var(--color-ink);
    text-align: left;
  }

  .shop-look__item.is-active {
    background: var(--item-color);
  }

  .shop-look__item-name {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }

  .shop-look__item-title {
    font: 400 var(--text-card-sm) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
  }

  @media screen and (max-width: 749px) {
    .shop-look__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .shop-look__stage {
      grid-column: auto;
    }

    .shop-look__card {
      width: min(220px, 60vw);
    }

    .shop-look__card--left { left: auto; right: -15px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the look",
  "class": "section-shop-the-look",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get the look" },
    { "type": "text", "id": "label", "label": "Label", "default": "Shop the studio" },
    {
      "type": "select",
      "id": "label_color",
      "label": "Label colour",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" }
      ],
      "default": "blue"
    },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Tap the dots" },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "title", "label": "Title", "info": "Used only when no product is selected." },
        { "type": "range", "id": "x", "label": "Position from left", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 30 },
        { "type": "range", "id": "y", "label": "Position from top", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 40 },
        {
          "type": "select",
          "id": "color",
          "label": "Highlight colour",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "grey", "label": "Grey" }
          ],
          "default": "blue"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the look",
      "blocks": [
        { "type": "hotspot", "settings": { "x": 22, "y": 34, "color": "blue" } },
        { "type": "hotspot", "settings": { "x": 62, "y": 46, "color": "grey" } },
        { "type": "hotspot", "settings": { "x": 40, "y": 78, "color": "blue" } }
      ]
    }
  ]
}
{% endschema %}
