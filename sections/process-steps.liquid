{% comment %}
  Process steps ("How it is made")
  Numbered step buttons on the left (a vertical tab list), and the selected
  step's illustration and text on the right. Each "Step" block can use one
  of the built-in illustrations or an uploaded image.
{% endcomment %}
{%- render 'section-border', section: section -%}
{%- assign steps = section.blocks | where: 'type', 'step' -%}
{%- if steps.size > 0 -%}
  <process-steps class="page process-steps space-{{ section.settings.spacing }}">
    {%- render 'section-head', label: section.settings.label, color: 'red', caption: section.settings.caption -%}
    <div class="process-steps__grid">
      <div class="process-steps__list" role="tablist" aria-orientation="vertical" aria-label="{{ section.settings.label | escape }}">
        {%- for block in steps -%}
          <button
            type="button"
            class="process-steps__tab"
            role="tab"
            id="ProcessTab-{{ block.id }}"
            aria-controls="ProcessPanel-{{ block.id }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            {% unless forloop.first %}tabindex="-1"{% endunless %}
            {{ block.shopify_attributes }}
          >
            <span class="label">{{ forloop.index | prepend: '0' }}</span>
            {{- block.settings.title | escape -}}
          </button>
        {%- endfor -%}
      </div>
      {%- for block in steps -%}
        <div
          class="process-steps__panel"
          role="tabpanel"
          id="ProcessPanel-{{ block.id }}"
          aria-labelledby="ProcessTab-{{ block.id }}"
          {% unless forloop.first %}hidden{% endunless %}
        >
          <div class="process-steps__art" style="--art-bg: var(--color-{{ block.settings.color }});">
            {%- if block.settings.image != blank or block.settings.video != blank -%}
              {%- render 'image-or-video', video: block.settings.video, image: block.settings.image, sizes: '(min-width: 750px) 33vw, 100vw', alt_fallback: block.settings.title -%}
            {%- else -%}
              {%- render 'process-illustration', name: block.settings.illustration, caption: block.settings.meta -%}
            {%- endif -%}
          </div>
          <div class="process-steps__text">
            <p class="process-steps__body">{{ block.settings.text | escape }}</p>
            {%- if block.settings.meta != blank -%}<span class="label label--sm">{{ block.settings.meta | escape }}</span>{%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </process-steps>
  <script src="{{ 'print-tools.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .process-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin-top: 8px;
  }

  .process-steps__list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .process-steps__tab {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 12px;
    border: var(--border);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    font: 400 26px / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    text-align: left;
  }

  .process-steps__tab:hover {
    background: var(--color-grey);
  }

  .process-steps__tab[aria-selected='true'] {
    background: var(--color-ink);
    color: var(--color-white);
  }

  .process-steps__panel {
    grid-column: span 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--grid-gap);
  }

  .process-steps__panel[hidden] {
    display: none;
  }

  .process-steps__art {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    padding: 16px;
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--art-bg);
  }

  .process-steps__art .process-illustration {
    width: 100%;
    height: 100%;
  }

  .process-steps__art > .media__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .process-steps__text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 4px 12px;
  }

  .process-steps__body {
    font: 400 26px / 1.1 var(--font-display);
    letter-spacing: -0.02em;
  }

  @media screen and (max-width: 749px) {
    .process-steps__grid,
    .process-steps__panel {
      grid-template-columns: minmax(0, 1fr);
    }

    .process-steps__panel {
      grid-column: auto;
    }

    .process-steps__text {
      padding: 8px 0 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Process steps",
  "class": "section-process-steps",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "checkbox", "id": "show_border", "label": "Show top border", "default": true },
    { "type": "text", "id": "label", "label": "Label", "default": "Chapter 02 — How it is made" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "From file to edition" },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Mark" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "The artist sends a file. We split it into one layer per ink, in black and white." },
        { "type": "text", "id": "meta", "label": "Detail", "default": "Per layer · 300 dpi" },
        {
          "type": "select",
          "id": "illustration",
          "label": "Illustration",
          "options": [
            { "value": "mark", "label": "Mark (artwork)" },
            { "value": "master", "label": "Master (stencil)" },
            { "value": "print", "label": "Print (drum)" },
            { "value": "edition", "label": "Edition (stack)" }
          ],
          "default": "mark"
        },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Replaces the illustration." },
        { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted on a loop instead of the image; the image becomes its poster." },
        {
          "type": "select",
          "id": "color",
          "label": "Background",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "grey", "label": "Grey" },
            { "value": "ink", "label": "Ink" }
          ],
          "default": "blue"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Process steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Mark", "illustration": "mark", "color": "blue" } },
        { "type": "step", "settings": { "title": "Master", "text": "Each layer is burned onto a thin master that wraps the drum, one master per colour.", "meta": "Burn time · 30 sec", "illustration": "master", "color": "grey" } }
      ]
    }
  ]
}
{% endschema %}
