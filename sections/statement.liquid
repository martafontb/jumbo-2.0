{% comment %}
  Statement
  A large intro statement spanning two of three columns (max 30ch), e.g.
  the homepage introduction. An optional button sits in the third column.
  With an image or video set, the media fills the right two columns and the
  text and button stay sticky in the left column while the media scrolls past.
{% endcomment %}
{%- liquid
  assign has_media = false
  if section.settings.image != blank or section.settings.video != blank
    assign has_media = true
  endif
-%}
<section class="page statement space-{{ section.settings.spacing }}">
  <div class="statement__grid{% if has_media %} statement__grid--media{% endif %}">
    {%- if has_media -%}
      <div class="statement__sticky">
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="statement__text statement__text--{{ section.settings.size }}">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="button {% if section.settings.button_style == 'block' %}statement__button--block{% else %}button--secondary{% endif %} statement__button" href="{{ section.settings.button_link | default: '#' }}">
        {{- section.settings.button_label | escape -}}
      </a>
    {%- endif -%}
    {%- if has_media -%}
      </div>
      <div class="media statement__media" style="--ratio: {{ section.settings.media_ratio }};">
        {%- render 'image-or-video', video: section.settings.video, image: section.settings.image, sizes: '(min-width: 750px) 66vw, 100vw', alt: section.settings.image_alt, placeholder: 'image' -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .statement__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: end;
    padding: 28px 0 20px;
  }

  .statement__text {
    grid-column: span 2;
    max-width: 30ch;
    font: 400 clamp(22px, 2.4vw, 38px) / 1.05 var(--font-display);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .statement__text--large {
    font-size: clamp(28px, 3.4vw, 54px);
    line-height: 1;
  }

  /* With media: text column left (sticky), media across the right two columns. */
  .statement__grid--media {
    align-items: start;
  }

  .statement__sticky {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    position: sticky;
    top: calc(var(--header-height) + 20px);
  }

  .statement__grid--media .statement__text {
    grid-column: auto;
  }

  .statement__media {
    grid-column: 2 / span 2;
  }

  .statement__text p + p {
    margin-top: 0.5em;
  }

  .statement__text strong {
    font-weight: 500;
  }

  .statement__button {
    justify-self: start;
  }

  /* Square ink block, as on the print guide. */
  .statement__button--block {
    border-radius: 0;
  }

  @media screen and (max-width: 749px) {
    .statement__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .statement__text {
      grid-column: auto;
    }

    .statement__sticky {
      position: static;
    }

    .statement__media {
      grid-column: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statement",
  "class": "section-statement",
  "tag": "div",
  "settings": [
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Jumbo Press is a risograph studio and publisher. We print editions, zines and books with artists, one colour at a time, in small runs.</p>"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        { "value": "regular", "label": "Regular" },
        { "value": "large", "label": "Large" }
      ],
      "default": "regular"
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Optional. Fills the right two columns; the text stays sticky while it scrolls." },
    { "type": "video", "id": "video", "label": "Video", "info": "Optional. Plays muted on a loop instead of the image; the image becomes its poster." },
    { "type": "text", "id": "image_alt", "label": "Media alt text" },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Media shape",
      "options": [
        { "value": "4 / 5", "label": "Portrait" },
        { "value": "1 / 1", "label": "Square" },
        { "value": "4 / 3", "label": "Landscape" }
      ],
      "default": "4 / 5"
    },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "pill", "label": "Outline pill" },
        { "value": "block", "label": "Ink block" }
      ],
      "default": "pill"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Statement" }]
}
{% endschema %}
