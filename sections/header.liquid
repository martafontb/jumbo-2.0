{% comment %}
  Header
  Sticky, transparent header using mix-blend-mode: difference, so it inverts
  over any background. Left: menu triggers. Centre: logo. Right: Search and
  Cart (n).

  Blocks, in order:
  - "Menu": one top-level nav item. If it has a Shopify menu, its links become
    the large coloured rows of a mega menu (desktop) and of the mobile menu.
    Without a menu it is a plain link.
  - "Product card" and "Info card" belong to the nearest "Menu" block above
    them and fill the mega menu's right-hand columns (2 cards fit).

  The section wrapper and <site-header> use display: contents so the header
  can stick across the whole page and still blend with the content behind
  it. A sticky ancestor would isolate the blend.
{% endcomment %}
{%- liquid
  assign menu_blocks = section.blocks | where: 'type', 'menu'
  assign logo_class = 'site-header__logo-img'
  if settings.logo_invert
    assign logo_class = logo_class | append: ' site-header__logo-img--invert'
  endif
  assign is_home = false
  if request.page_type == 'index'
    assign is_home = true
  endif
-%}

<site-header class="site-header-root">
  <header class="site-header{% if section.settings.sticky %} site-header--sticky{% endif %}" data-header>
    <div class="site-header__start">
      <button
        type="button"
        class="site-header__toggle"
        aria-expanded="false"
        aria-controls="MobileMenu"
        data-mobile-toggle
      >
        <span data-toggle-label-closed>{{ 'sections.header.menu' | t }}</span>
        <span data-toggle-label-open hidden>{{ 'sections.header.close' | t }}</span>
      </button>

      {%- if menu_blocks.size > 0 -%}
        <nav class="site-header__nav" aria-label="{{ 'sections.header.main_navigation' | t }}">
          <ul class="site-header__list" role="list">
            {%- for block in menu_blocks -%}
              {%- assign delay = forloop.index | times: 0.05 -%}
              <li class="nav-in" style="--delay: {{ delay }}s;">
                <span class="nav-in__inner">
                  {%- if block.settings.menu.links.size > 0 -%}
                    <button
                      type="button"
                      class="site-header__link"
                      aria-expanded="false"
                      aria-controls="MegaMenu-{{ block.id }}"
                      data-mega-trigger="MegaMenu-{{ block.id }}"
                    >
                      {%- capture label -%}{{ block.settings.label | escape }} <span class="site-header__caret" aria-hidden="true">▾</span>{%- endcapture -%}
                      {%- render 'roll-text', text: label -%}
                    </button>
                  {%- else -%}
                    {%- assign label = block.settings.label | escape -%}
                    {%- if block.settings.link != blank -%}
                      <a class="site-header__link" href="{{ block.settings.link }}">
                        {%- render 'roll-text', text: label -%}
                      </a>
                    {%- else -%}
                      <span class="site-header__link site-header__link--static">
                        {%- render 'roll-text', text: label -%}
                      </span>
                    {%- endif -%}
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>

    <div class="site-header__logo nav-in" style="--delay: 0s;">
      <span class="nav-in__inner">
        {%- if is_home -%}<h1 class="site-header__logo-heading">{%- endif -%}
        <a href="{{ routes.root_url }}" class="site-header__logo-link tap-target">
          {%- render 'logo-animated', invert: settings.logo_invert -%}  
        {% comment %} {%- if settings.logo != blank -%}
            {{
              settings.logo
              | image_url: height: 160
              | image_tag:
                class: logo_class,
                alt: shop.name,
                loading: 'eager',
                fetchpriority: 'high'
            }}
          {%- else -%}
            <span class="site-header__wordmark">{{ shop.name | escape }}</span>
          {%- endif -%} {% endcomment %}
        </a>
        {%- if is_home -%}</h1>{%- endif -%}
      </span>
    </div>

    <ul class="site-header__actions" role="list">
      {%- if section.settings.show_search -%}
        <li class="site-header__search nav-in" style="--delay: 0.3s;">
          <span class="nav-in__inner">
            <a href="{{ routes.search_url }}" class="site-header__link" data-search-trigger aria-haspopup="dialog">
              {%- assign label = 'sections.header.search' | t -%}
              {%- render 'roll-text', text: label -%}
            </a>
          </span>
        </li>
      {%- endif -%}
      <li class="nav-in" style="--delay: 0.35s;">
        <span class="nav-in__inner">
          <a href="{{ routes.cart_url }}" class="site-header__link" data-cart-trigger>
            {%- capture label -%}{{ 'sections.header.cart' | t }} (<span data-cart-count>{{ cart.item_count }}</span>){%- endcapture -%}
            {%- render 'roll-text', text: label -%}
          </a>
        </span>
      </li>
    </ul>
  </header>

  {%- comment -%} Mega menus sit outside the blended header so they render in true colour. {%- endcomment -%}
  <div class="mega-menus">
    {%- for block in section.blocks -%}
      {%- if block.type != 'menu' or block.settings.menu.links.size == 0 -%}
        {%- continue -%}
      {%- endif -%}
      <div class="mega" id="MegaMenu-{{ block.id }}" data-mega-panel hidden {{ block.shopify_attributes }}>
        <div class="mega__rows">
          {%- render 'menu-rows', block: block -%}
        </div>
        {%- for card in section.blocks offset: forloop.index -%}
          {%- if card.type == 'menu' -%}{%- break -%}{%- endif -%}
          {%- render 'mega-card', block: card -%}
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </div>

  <div class="mobile-menu" id="MobileMenu" data-mobile-menu hidden>
    <nav class="mobile-menu__inner" aria-label="{{ 'sections.header.main_navigation' | t }}">
      {%- for block in menu_blocks -%}
        {%- if block.settings.show_on_mobile == false or block.settings.menu.links.size == 0 -%}
          {%- continue -%}
        {%- endif -%}
        <div class="mobile-menu__group">
          <span class="pill pill--{{ block.settings.mobile_pill_color }}">{{ block.settings.label | escape }}</span>
          <div class="mobile-menu__rows">
            {%- render 'menu-rows', block: block -%}
          </div>
        </div>
      {%- endfor -%}

      {%- if section.settings.mobile_menu.links.size > 0 or section.settings.show_search -%}
        <div class="mobile-menu__group">
          {%- if section.settings.mobile_menu_heading != blank -%}
            <span class="pill pill--grey">{{ section.settings.mobile_menu_heading | escape }}</span>
          {%- endif -%}
          <div class="mobile-menu__rows">
            {%- for link in section.settings.mobile_menu.links -%}
              {%- render 'menu-row', link: link, style: 'md' -%}
            {%- endfor -%}
            {%- if section.settings.show_search -%}
              <a class="menu-row menu-row--md" href="{{ routes.search_url }}" data-search-trigger aria-haspopup="dialog">
                <span class="menu-row__label">{{ 'sections.header.search' | t }}</span>
                <span class="menu-row__arrow" aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </nav>
  </div>

  {%- if section.settings.show_search -%}
    {%- render 'search-overlay', settings: section.settings -%}
  {%- endif -%}
</site-header>

<script src="{{ 'header.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .section-header,
  .site-header-root {
    display: contents;
  }

  .site-header {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 18px var(--page-pad-x);
    background: transparent;
    color: var(--color-white);
    mix-blend-mode: difference;
    font: 400 var(--text-label) / 1.3 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    white-space: nowrap;
    position: relative;
    z-index: var(--z-header);
  }

  .site-header--sticky {
    position: sticky;
    top: 0;
  }

  .site-header a,
  .site-header button,
  .site-header a:hover,
  .site-header__link--static {
    color: var(--color-white);
  }

  /* White blends to near-ink under mix-blend-mode: difference, so the ring stays visible. */
  .site-header :focus-visible {
    outline-color: var(--color-white);
  }

  .site-header__start {
    display: flex;
    align-items: center;
  }

  .site-header__list,
  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-header__actions {
    justify-content: flex-end;
  }

  .site-header__link {
    display: inline-block;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: none;
    cursor: pointer;
  }

  .site-header__link--static {
    cursor: default;
  }

  .site-header__caret {
    font-size: 0.9em;
  }

  .site-header__toggle {
    display: none;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-align: left;
  }

  .site-header__logo {
    justify-self: center;
  }

  .site-header__logo-heading {
    font: inherit;
  }

  .site-header__logo-link {
    display: inline-block;
    line-height: 0;
    text-decoration: none;
  }

  .site-header__logo-img {
    display: block;
    width: auto;
    height: var(--logo-height);
  }

  .site-header__logo-img--invert {
    filter: invert(1);
  }

  .site-header__wordmark {
    display: block;
    font: 800 calc(var(--logo-height) * 0.8) / 1.25 var(--font-display);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  /* Text roll on hover */
  .roll {
    display: inline-block;
    overflow: hidden;
    height: 1.3em;
    line-height: 1.3em;
    vertical-align: top;
  }

  .roll__inner {
    display: flex;
    flex-direction: column;
    transition: transform var(--duration-roll) var(--ease-in-out);
  }

  @media (hover: hover) {
    .site-header__link:hover .roll__inner,
    .site-header__link[aria-expanded='true'] .roll__inner {
      transform: translateY(-50%);
    }
  }

  /* Entrance: items slide up inside an overflow-hidden wrapper */
  .nav-in {
    display: block;
    overflow: hidden;
  }

  .nav-in__inner {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .has-animations .nav-in__inner {
      animation: nav-in var(--duration-nav-in) var(--ease-out-expo) var(--delay, 0s) both;
    }
  }

  /* Mega menus */
  .mega-menus {
    position: sticky;
    top: var(--header-height);
    z-index: var(--z-menu);
    height: 0;
  }

  /* Backdrop behind the open mega menu; page scroll is locked meanwhile. */
  .mega-menus::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    background: rgb(0 0 0 / 0.4);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  html.mega-open .mega-menus::before {
    opacity: 1;
  }

  html.mega-open {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .mega {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    padding: 4px var(--page-pad-x) 20px;
    border-bottom: var(--border);
    background: var(--color-bg);
    animation: fade 0.2s both;
  }

  .mega__rows {
    display: flex;
    flex-direction: column;
    margin-top: 4px;
    border-top: var(--border);
  }

  /* Mobile menu */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-header-strip);
    overflow: auto;
    overscroll-behavior: contain;
    padding: var(--mobile-menu-top, 72px) var(--page-pad-x) 32px;
    background: var(--color-bg);
    animation: fade 0.2s both;
  }

  .mobile-menu__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .mobile-menu__group {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__group > .pill {
    margin-bottom: 8px;
  }

  .mobile-menu__rows {
    border-top: var(--border);
  }

  @media screen and (min-width: 750px) {
    .mobile-menu {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    .site-header {
      height: var(--header-height);
      padding: 0 var(--page-pad-x);
      gap: 8px;
    }

    .site-header__toggle {
      display: inline-block;
    }

    .site-header__nav,
    .site-header__search,
    .mega-menus {
      display: none;
    }

    .site-header__actions a {
      display: flex;
      align-items: center;
      min-height: 44px;
    }
  }

  html:not(.js) .site-header__toggle {
    display: none;
  }

  @media screen and (max-width: 749px) {
    html:not(.js) .site-header__nav {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "max_blocks": 12,
  "settings": [
    {
      "type": "paragraph",
      "content": "Logo and colours are in Theme settings. Add a Menu block for each top-level item, then Product or Info cards directly below it to fill its mega menu."
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile menu"
    },
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Secondary links",
      "info": "Shown below the main groups as smaller rows, e.g. About, Artists, Print guide, FAQ."
    },
    {
      "type": "text",
      "id": "mobile_menu_heading",
      "label": "Secondary links heading",
      "default": "Info"
    },
    {
      "type": "header",
      "content": "Search"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Placeholder",
      "default": "Search editions, zines, artists…"
    },
    {
      "type": "text",
      "id": "search_suggestions_label",
      "label": "Suggestions label",
      "default": "Try"
    },
    {
      "type": "text",
      "id": "search_suggestions",
      "label": "Suggested searches",
      "info": "Comma-separated.",
      "default": "Zines, Editions, Books, Process"
    },
    {
      "type": "collection",
      "id": "search_collection",
      "label": "Products shown before typing"
    },
    {
      "type": "text",
      "id": "search_collection_label",
      "label": "Label for those products",
      "default": "Trending now"
    },
    {
      "type": "text",
      "id": "search_empty_hint",
      "label": "No results hint",
      "info": "Shown after “Nothing for …”.",
      "default": "Try zines or editions."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Mega menu links",
          "info": "Each link becomes a large row. Collection links show their product count automatically."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Used when no menu is selected."
        },
        {
          "type": "text",
          "id": "row_colors",
          "label": "Row colours",
          "info": "Comma-separated, repeating: blue, red, grey, ink, white, bg.",
          "default": "blue, grey, blue, red, grey, white"
        },
        {
          "type": "textarea",
          "id": "row_pills",
          "label": "Row pill text",
          "info": "Optional, one line per row in menu order. Overrides the automatic count. Leave a line empty to keep it."
        },
        {
          "type": "checkbox",
          "id": "show_on_mobile",
          "label": "Show in mobile menu",
          "default": true
        },
        {
          "type": "select",
          "id": "mobile_pill_color",
          "label": "Mobile heading colour",
          "options": [
            { "value": "red", "label": "Red" },
            { "value": "blue", "label": "Blue" },
            { "value": "grey", "label": "Grey" }
          ],
          "default": "red"
        }
      ]
    },
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Defaults to the product's featured image."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Optional. Plays muted on a loop instead of the image."
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "New edition"
        },
        {
          "type": "select",
          "id": "tag_color",
          "label": "Tag colour",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "grey", "label": "Grey" },
            { "value": "bg", "label": "Background" }
          ],
          "default": "blue"
        },
        {
          "type": "select",
          "id": "ground",
          "label": "Image background",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "grey", "label": "Grey" },
            { "value": "ink", "label": "Ink" }
          ],
          "default": "blue"
        }
      ]
    },
    {
      "type": "info_card",
      "name": "Info card",
      "settings": [
        {
          "type": "select",
          "id": "ground",
          "label": "Background",
          "options": [
            { "value": "grey", "label": "Grey" },
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" }
          ],
          "default": "grey"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Specs"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "specs",
          "label": "Spec list",
          "info": "One per line, as Label | Value. E.g. Process | Risograph, 1–3 inks"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
