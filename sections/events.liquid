{% comment %}
  Events ("Find us")
  A featured upcoming event (image, date line, title, live countdown,
  directions and reminder), filter chips by kind, and a list of upcoming
  events. Each "Event" block is one event. Past events hide themselves.

  Start / end use the format YYYY-MM-DD HH:MM in the store's time zone.
  "Remind me" downloads a calendar file (.ics) for the event; nothing is
  stored or sent anywhere.
{% endcomment %}
{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign upcoming = ''
  assign featured_id = ''
  assign kinds = ''
  for block in section.blocks
    if block.type != 'event' or block.settings.start == blank
      continue
    endif
    assign ends = block.settings.end | default: block.settings.start
    assign end_ts = ends | date: '%s' | plus: 0
    if end_ts < now_ts and request.design_mode == false
      continue
    endif
    assign upcoming = upcoming | append: block.id | append: ','
    if featured_id == blank and block.settings.featured
      assign featured_id = block.id
    endif
    if block.settings.kind != blank
      assign kinds = kinds | append: block.settings.kind | append: '|'
    endif
  endfor
  assign upcoming_ids = upcoming | split: ','
  if featured_id == blank and upcoming_ids.size > 0
    assign featured_id = upcoming_ids[0]
  endif
  assign kind_list = kinds | split: '|' | uniq
-%}
<section class="page events space-{{ section.settings.spacing }}">
  {%- render 'section-head', label: section.settings.label, color: section.settings.label_color, caption: section.settings.caption -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="events__heading">{{ section.settings.heading | escape }}<span class="dot">.</span></h2>
  {%- endif -%}

  {%- if upcoming_ids.size == 0 -%}
    {%- if section.settings.empty_text != blank -%}
      <p class="title-statement events__empty">{{ section.settings.empty_text | escape }}</p>
    {%- endif -%}
  {%- else -%}
    <event-list class="events__body" data-reminder-set="{{ 'sections.events.reminder_set' | t | escape }}" data-reminder-set-short="{{ 'sections.events.set' | t | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.id != featured_id -%}{%- continue -%}{%- endif -%}
        {%- liquid
          assign start_ts = block.settings.start | date: '%s'
          assign ends = block.settings.end | default: block.settings.start
          assign end_ts = ends | date: '%s'
        -%}
        <div class="events__feature" {{ block.shopify_attributes }}>
          <div class="media events__feature-media" style="--ratio: auto; --media-bg: var(--color-blue);">
            {%- render 'image', image: section.settings.feature_image, sizes: '(min-width: 750px) 33vw, 100vw', alt: section.settings.feature_image_alt, placeholder: 'lifestyle-2' -%}
            {%- if section.settings.feature_label != blank -%}
              <span class="pill pill--grey">{{ section.settings.feature_label | escape }}</span>
            {%- endif -%}
          </div>
          <div class="events__feature-card">
            <div>
              <p class="label label--sm events__date-line">
                {%- if block.settings.date_label != blank -%}
                  {{ block.settings.date_label | escape }}
                {%- else -%}
                  {{ block.settings.start | date: '%a %-d %b' }}
                {%- endif -%}
                {%- if block.settings.location != blank %} · {{ block.settings.location | escape }}{% endif -%}
              </p>
              <h3 class="events__feature-title">{{ block.settings.title | escape }}</h3>
            </div>
            <div class="events__countdown" data-countdown="{{ start_ts }}" role="timer" aria-label="{{ 'sections.events.countdown' | t }}">
              {%- for unit in (1..4) -%}
                {%- case unit -%}
                  {%- when 1 -%}{%- assign unit_key = 'days' -%}{%- assign unit_label = 'sections.events.units.days' | t -%}
                  {%- when 2 -%}{%- assign unit_key = 'hours' -%}{%- assign unit_label = 'sections.events.units.hours' | t -%}
                  {%- when 3 -%}{%- assign unit_key = 'minutes' -%}{%- assign unit_label = 'sections.events.units.minutes' | t -%}
                  {%- when 4 -%}{%- assign unit_key = 'seconds' -%}{%- assign unit_label = 'sections.events.units.seconds' | t -%}
                {%- endcase -%}
                <div class="events__count{% if unit == 4 %} events__count--accent{% endif %}">
                  <span class="events__count-n" data-unit="{{ unit_key }}">--</span>
                  <span class="events__count-l">{{ unit_label }}</span>
                </div>
              {%- endfor -%}
            </div>
            <div class="events__actions">
              {%- if block.settings.directions_url != blank -%}
                <a class="button events__button" href="{{ block.settings.directions_url }}" target="_blank" rel="noopener">
                  {{- 'sections.events.directions' | t -}}
                  <span class="visually-hidden"> {{ 'accessibility.opens_new_window' | t }}</span>
                </a>
              {%- endif -%}
              {%- render 'event-remind', block: block, start_ts: start_ts, end_ts: end_ts, class: 'button button--secondary events__button', label_key: 'sections.events.remind' -%}
            </div>
          </div>
        </div>
      {%- endfor -%}

      {%- if kind_list.size > 1 -%}
        <div class="events__filters" role="group" aria-label="{{ 'sections.events.filter' | t }}">
          <button type="button" class="chip events__chip" aria-pressed="true" data-filter="">{{ 'sections.events.all' | t }}</button>
          {%- for kind in kind_list -%}
            <button type="button" class="chip events__chip" aria-pressed="false" data-filter="{{ kind | handle }}">{{ kind | escape }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <ul class="events__list" role="list">
        {%- for block in section.blocks -%}
          {%- unless upcoming_ids contains block.id -%}{%- continue -%}{%- endunless -%}
          {%- liquid
            assign start_ts = block.settings.start | date: '%s'
            assign ends = block.settings.end | default: block.settings.start
            assign end_ts = ends | date: '%s'
          -%}
          <li class="events__row" data-kind="{{ block.settings.kind | handle }}" {{ block.shopify_attributes }}>
            <p class="events__day">
              <span class="events__day-n">{{ block.settings.start | date: '%d' }}</span>
              <span class="label label--sm">{{ block.settings.start | date: '%b' }}</span>
            </p>
            <div class="events__info">
              <h3 class="events__title">{{ block.settings.title | escape }}</h3>
              {%- if block.settings.location != blank -%}
                <span class="label label--sm">{{ block.settings.location | escape }}</span>
              {%- endif -%}
              {%- if block.settings.kind != blank -%}
                <span class="pill pill--{{ block.settings.kind_color }}">{{ block.settings.kind | escape }}</span>
              {%- endif -%}
            </div>
            <div class="events__row-actions">
              {%- render 'event-remind', block: block, start_ts: start_ts, end_ts: end_ts, class: 'button button--secondary button--small', label_key: 'sections.events.remind', short: true -%}
              {%- if block.settings.details_url != blank -%}
                <a class="button button--small" href="{{ block.settings.details_url }}">
                  {{- 'sections.events.details' | t -}}
                  <span class="visually-hidden">: {{ block.settings.title | escape }}</span>
                </a>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </event-list>
    <script src="{{ 'event-list.js' | asset_url }}" type="module"></script>
  {%- endif -%}
</section>

{% stylesheet %}
  .events__heading {
    padding: 8px 0 14px;
    font: 500 clamp(40px, 6vw, 96px) / 0.95 var(--font-display);
    letter-spacing: -0.035em;
  }

  .events__body {
    display: block;
  }

  .events__feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--grid-gap);
  }

  .events__feature-media {
    min-height: 260px;
  }

  .events__feature-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 14px;
    border: var(--border);
    border-radius: var(--radius-lg);
  }

  .events__date-line {
    opacity: 0.7;
    text-transform: uppercase;
  }

  .events__feature-title {
    margin-top: 8px;
    font: 400 clamp(36px, 4.4vw, 72px) / 0.9 var(--font-display);
    letter-spacing: -0.05em;
  }

  .events__countdown {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--grid-gap);
    text-align: center;
  }

  .events__count {
    display: flex;
    flex-direction: column;
    padding: 8px 0;
    border: var(--border);
    border-radius: var(--radius-sm);
  }

  .events__count--accent {
    background: var(--color-grey);
  }

  .events__count-n {
    font: 500 clamp(24px, 3vw, 44px) / 1 var(--font-display);
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .events__count-l {
    font: 400 10px / 1.4 var(--font-mono);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .events__actions {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .events__button {
    padding: 14px;
    font-size: var(--text-label-sm);
  }

  .events__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 24px;
    padding-top: 10px;
    border-top: var(--border);
  }

  .events__chip {
    font-size: var(--text-label);
  }

  .events__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: var(--border);
  }

  .events__filters + .events__list {
    margin-top: 10px;
  }

  .events__feature + .events__list {
    margin-top: 24px;
  }

  .events__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    align-items: center;
    padding: 14px 0;
    border-bottom: var(--border);
  }

  .events__day {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .events__day-n {
    font: 500 clamp(40px, 5vw, 80px) / 0.9 var(--font-display);
    letter-spacing: -0.05em;
  }

  .events__info {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .events__title {
    font: 400 22px / 1.1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .events__row-actions {
    display: flex;
    justify-content: flex-end;
    gap: 4px;
  }

  .events__row-actions .button {
    padding: 12px 14px;
  }

  [data-remind].is-set {
    background: var(--color-blue);
    border-color: var(--color-ink);
    color: var(--color-white);
  }

  @media screen and (max-width: 749px) {
    .events__feature,
    .events__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .events__row-actions {
      justify-content: flex-start;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events",
  "class": "section-events",
  "tag": "div",
  "max_blocks": 16,
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Find us" },
    {
      "type": "select",
      "id": "label_color",
      "label": "Label colour",
      "options": [
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" }
      ],
      "default": "blue"
    },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Fairs, workshops, launches" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See you there" },
    { "type": "header", "content": "Featured event" },
    { "type": "paragraph", "content": "The first upcoming event ticked as Featured, otherwise the next upcoming event." },
    { "type": "image_picker", "id": "feature_image", "label": "Image" },
    { "type": "text", "id": "feature_image_alt", "label": "Image alt text" },
    { "type": "text", "id": "feature_label", "label": "Image label", "default": "Next fair" },
    { "type": "text", "id": "empty_text", "label": "Text when no events are coming up", "default": "New dates coming soon." },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Small Press Fair" },
        { "type": "text", "id": "kind", "label": "Kind", "info": "Used for the filter chips, e.g. Fairs, Workshops, Launches.", "default": "Fairs" },
        {
          "type": "select",
          "id": "kind_color",
          "label": "Kind colour",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "red", "label": "Red" },
            { "value": "grey", "label": "Grey" }
          ],
          "default": "grey"
        },
        { "type": "text", "id": "start", "label": "Starts", "info": "YYYY-MM-DD HH:MM, e.g. 2026-11-07 10:00", "default": "2026-11-07 10:00" },
        { "type": "text", "id": "end", "label": "Ends", "info": "Optional, same format. The event hides after this." },
        { "type": "text", "id": "date_label", "label": "Date text", "info": "Optional, e.g. Sat 7 – Sun 8 Nov. Defaults to the start date." },
        { "type": "text", "id": "location", "label": "Location", "default": "Canal Yard" },
        { "type": "url", "id": "directions_url", "label": "Directions link", "info": "E.g. a Google Maps link." },
        { "type": "url", "id": "details_url", "label": "Details link" },
        { "type": "checkbox", "id": "featured", "label": "Featured", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Events",
      "blocks": [
        { "type": "event", "settings": { "title": "Small Press Fair", "kind": "Fairs", "start": "2026-11-07 10:00", "end": "2026-11-08 18:00", "date_label": "Sat 7 – Sun 8 Nov", "location": "Canal Yard", "featured": true } }
      ]
    }
  ]
}
{% endschema %}
