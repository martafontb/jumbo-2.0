{% comment %}
  Pairs well with ("Complete the set")
  Add-on cards with a tag pill, title, price, a short blurb and "+ Add to
  cart". Products come from the product metafield custom.pairs_with (list of
  products), falling back to the section's collection. Products already in
  the cart are hidden; when everything is in the cart a short message shows.
{% endcomment %}
{%- render 'section-border', section: section -%}
{%- liquid
  assign source = product.metafields.custom.pairs_with.value
  if source == blank and section.settings.collection != blank
    assign source = section.settings.collection.products
  endif
  assign in_cart = cart.items | map: 'product_id' | join: ','
  assign in_cart = ',' | append: in_cart | append: ','
  assign palette = 'blue,grey,red' | split: ','
  assign candidates = 0
  assign shown = 0
-%}
{%- if source != blank -%}
  <section class="page product-pairs space-{{ section.settings.spacing }}">
    {%- render 'section-head', label: section.settings.label, color: 'blue', caption: section.settings.caption -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="product-pairs__heading">{{ section.settings.heading | escape }}<span class="dot">.</span></h2>
    {%- endif -%}
    <ul class="product-pairs__grid" role="list">
      {%- for item in source -%}
        {%- if item.id == product.id or item.available == false -%}{%- continue -%}{%- endif -%}
        {%- assign candidates = candidates | plus: 1 -%}
        {%- assign needle = ',' | append: item.id | append: ',' -%}
        {%- if in_cart contains needle -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign ground_index = shown | minus: 1 | modulo: 3 -%}
        <li class="product-pairs__card quick-add-host">
          <a class="product-pairs__link" href="{{ item.url }}">
            <div class="media" style="--ratio: 4 / 3; --media-bg: var(--color-{{ palette[ground_index] }});">
              {%- render 'image', image: item.featured_media, sizes: '(min-width: 750px) 33vw, 100vw', alt_fallback: item.title, placeholder: 'product-4' -%}
              {%- assign tag = item.metafields.custom.card_tag.value -%}
              {%- if tag != blank -%}<span class="pill pill--red">{{ tag | escape }}</span>{%- endif -%}
            </div>
            <span class="product-pairs__meta">
              <span class="product-pairs__title">{{ item.title | escape }}</span>
              {%- render 'price', product: item -%}
            </span>
          </a>
          {%- assign blurb = item.metafields.custom.card_meta.value | default: item.description | strip_html | truncatewords: 12 -%}
          {%- if blurb != blank -%}<p class="product-pairs__blurb">{{ blurb | escape }}</p>{%- endif -%}
          {%- assign add_label = 'sections.shop_the_look.add' | t -%}
          {%- render 'quick-add', product: item, ratio: '4 / 3', label: add_label -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if shown == 0 and candidates > 0 -%}
      <p class="label label--sm product-pairs__done">{{ section.settings.done_text | escape }}</p>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .product-pairs__heading {
    padding: 8px 0 10px;
    font: 500 clamp(40px, 6vw, 60px) / 0.9 var(--font-display);
    letter-spacing: -0.05em;
  }

  .product-pairs__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-pairs__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .product-pairs__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--color-ink);
    text-decoration: none;
  }

  .product-pairs__meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px;
    padding-top: 6px;
    border-top: var(--border);
  }

  .product-pairs__title {
    font: 400 var(--text-card-sm) / 1.1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .product-pairs__blurb {
    font: 400 14px / 1.3 var(--font-display);
  }

  .product-pairs__done {
    padding: 12px 0;
  }

  @media screen and (max-width: 749px) {
    .product-pairs__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Pairs well with",
  "class": "section-product-pairs",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_border", "label": "Show top border", "default": true },
    { "type": "paragraph", "content": "Uses the product's custom.pairs_with metafield (list of products), or this collection when that's empty." },
    { "type": "collection", "id": "collection", "label": "Fallback collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "text", "id": "label", "label": "Label", "default": "Pairs well with" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Add to the same parcel" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the set" },
    { "type": "text", "id": "done_text", "label": "Text when everything is in the cart", "default": "Everything's in your cart. Nice set." },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "large"
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Pairs well with" }]
}
{% endschema %}
