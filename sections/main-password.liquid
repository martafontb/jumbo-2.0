{% comment %}
  Password page
  Shown while the store is password protected: logo or store name, a
  message, the storefront password form and an optional newsletter form.
{% endcomment %}
<div class="page main-password">
  <div class="main-password__inner">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: height: 160 | image_tag: class: 'main-password__logo', alt: shop.name }}
    {%- else -%}
      <p class="main-password__wordmark">{{ shop.name | escape }}</p>
    {%- endif -%}

    <h1 class="title-page">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading | escape }}
      {%- else -%}
        {{ 'general.password.title' | t }}
      {%- endif -%}
      <span class="dot">.</span>
    </h1>

    {%- if shop.password_message != blank -%}
      <p class="title-statement">{{ shop.password_message }}</p>
    {%- endif -%}

    {%- form 'storefront_password', class: 'main-password__form' -%}
      <label class="visually-hidden" for="Password">{{ 'general.password.label' | t }}</label>
      <input
        class="field"
        type="password"
        name="password"
        id="Password"
        autocomplete="current-password"
        placeholder="{{ 'general.password.label' | t }}"
        {% if form.errors %}
          aria-invalid="true" aria-describedby="PasswordError"
        {% endif %}
      >
      <button type="submit" class="button">{{ 'general.password.enter' | t }}</button>
      {%- if form.errors -%}
        <p class="form-message form-message--error" id="PasswordError">{{ form.errors.messages['form'] }}</p>
      {%- endif -%}
    {%- endform -%}

    <p class="label label--sm main-password__admin">
      <a href="/admin">{{ 'general.password.admin_link' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .main-password__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    min-height: 100vh;
    padding: 24px 0;
  }

  .main-password__logo {
    width: auto;
    height: var(--logo-height);
  }

  .main-password__wordmark {
    font: 800 40px / 1 var(--font-display);
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .main-password__form {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    width: min(100%, 480px);
  }

  .main-password__form .field {
    flex: 1 1 220px;
  }

  .main-password__admin {
    margin-top: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" }
  ]
}
{% endschema %}
