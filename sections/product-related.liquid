{% comment %}
  Product related ("Also from …")
  A drag-to-scroll carousel of square image cards (three in view on
  desktop, about 1.7 on mobile). Source: the artist's collection (field
  `collection` on the custom.artist metaobject), excluding this product;
  otherwise Shopify's related-product recommendations, fetched after load
  via the Section Rendering API. The heading's [artist] token is replaced
  with the artist's name (or the store name).
{% endcomment %}
{%- render 'section-border', section: section -%}
{%- liquid
  assign artist = product.metafields.custom.artist.value
  assign artist_collection = artist.collection.value
  assign artist_name = artist.name.value | default: shop.name
  assign heading = section.settings.heading | replace: '[artist]', artist_name
  assign items = blank
  assign source = 'none'
  if artist_collection != blank and artist_collection.products_count > 1
    assign items = artist_collection.products
    assign source = 'artist'
  elsif recommendations.performed
    assign items = recommendations.products
    assign source = 'recommendations'
  endif
-%}
<product-related
  class="page product-related space-{{ section.settings.spacing }}"
  {% if source == 'none' %}
    data-recommendations-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  {% endif %}
  data-related
>
  {%- if source != 'none' and items.size > 0 -%}
    <h2 class="label label--sm product-related__head">{{ heading | escape }}</h2>
    <drag-scroller
      class="scroller product-related__track"
      data-draggable
      tabindex="0"
      role="region"
      aria-label="{{ heading | escape }}"
    >
      {%- assign palette = 'grey,red,ink' | split: ',' -%}
      {%- assign shown = 0 -%}
      {%- for item in items -%}
        {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign shown = shown | plus: 1 -%}
        {%- assign ground_index = shown | modulo: 3 -%}
        <div class="product-related__card">
          <a class="media product-related__link" href="{{ item.url }}" style="--ratio: 1; --media-bg: var(--color-{{ palette[ground_index] }});">
            {%- render 'image', image: item.featured_media, sizes: '(min-width: 750px) 33vw, 60vw', alt: item.title, placeholder: 'product-3' -%}
          </a>
          {%- if section.settings.quick_add -%}
            <div class="product-related__quick-add">
              {%- if item.has_only_default_variant -%}
                {%- render 'add-to-cart-form', product: item, class: 'button--full' -%}
              {%- else -%}
                <a class="button button--small button--full" href="{{ item.url }}">{{ 'products.choose_options' | t }}</a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </drag-scroller>
  {%- endif -%}
</product-related>

<script src="{{ 'product-related.js' | asset_url }}" type="module"></script>
{%- comment -%} Outside <product-related>: scripts in fetched recommendations markup don't execute. {%- endcomment -%}
<script src="{{ 'product-form.js' | asset_url }}" type="module"></script>
<script src="{{ 'drag-scroller.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .product-related__head {
    margin: 0 0 4px;
    padding-top: 8px;
    border-top: var(--section-border, var(--border));
  }

  .product-related__link {
    display: block;
  }

  .product-related__quick-add {
    margin-top: 4px;
  }

  .product-related__card {
    display: block;
    width: calc((100% - var(--grid-gap) * 2) / 3);
  }

  @media screen and (max-width: 749px) {
    .product-related__card {
      width: calc((100% - var(--grid-gap)) / 1.7);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related products",
  "class": "section-product-related",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_border", "label": "Show top border", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "info": "[artist] is replaced with the artist's name.", "default": "Also from [artist] & Jumbo Press" },
    { "type": "range", "id": "limit", "label": "Products", "info": "More than 3 makes the row scroll on desktop.", "min": 3, "max": 12, "step": 3, "default": 9 },
    { "type": "checkbox", "id": "quick_add", "label": "Show quick add to cart", "info": "Products with several variants link to the product page instead.", "default": true },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "small"
    }
  ],
  "enabled_on": { "templates": ["product"] },
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
