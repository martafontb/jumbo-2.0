{% comment %}
  Hero
  One block: a full-width looping muted video (or an image), then one
  headline and one button. Everything is editable in the theme editor.

  The customer quote no longer lives here. It is its own "Reviews strip"
  section right below the hero.

  The video is Shopify-hosted (Content > Files). A pause button is always
  shown for autoplaying video (WCAG 2.2.2); under reduced motion the video
  starts paused.
{% endcomment %}
{%- liquid
  assign has_video = false
  if section.settings.video != blank
    assign has_video = true
  endif
-%}
<hero-section
  class="page hero space-{{ section.settings.spacing }}"
  data-play-label="{{ 'sections.hero.play' | t | escape }}"
  data-pause-label="{{ 'sections.hero.pause' | t | escape }}"
>
  <div class="media hero__main" style="--media-bg: var(--color-{{ section.settings.main_ground }});">
    {%- if has_video -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          image_size: '1600x',
          class: 'hero__video'
      }}
      <button type="button" class="hero__play icon-button" data-hero-toggle aria-label="{{ 'sections.hero.pause' | t }}">
        <span data-icon-pause aria-hidden="true">❚❚</span>
        <span data-icon-play aria-hidden="true" hidden>▶</span>
      </button>
    {%- else -%}
      {%- render 'image',
        image: section.settings.image,
        sizes: '100vw',
        alt: section.settings.image_alt,
        eager: true,
        placeholder: 'hero-apparel-1'
      -%}
    {%- endif -%}
  </div>

  {%- if section.settings.headline != blank or section.settings.button_label != blank -%}
    <div class="hero__content">
      {%- if section.settings.headline != blank -%}
        <h1 class="title-page hero__headline">{{ section.settings.headline | escape }}</h1>
      {%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a class="button hero__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  {%- endif -%}
</hero-section>

<script src="{{ 'hero.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .hero__main {
    --ratio: 16 / 9;
  }

  .hero__main > .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__play {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 3;
    width: 44px;
    height: 44px;
    background: var(--color-bg);
    font-size: 12px;
  }

  .hero__content {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 40px;
    padding-top: 24px;
  }

  .hero__headline {
    max-width: 16ch;
  }

  @media screen and (max-width: 749px) {
    .hero__main {
      --ratio: 1 / 1;
    }

    .hero__content {
      flex-direction: column;
      align-items: stretch;
      gap: 16px;
      padding-top: 16px;
    }

    .hero__button {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Media" },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Plays muted on a loop. Upload in Content > Files. Leave empty to use the image."
    },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Shown when there's no video." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "info": "Describe the image for screen readers. Defaults to the image's alt text." },
    {
      "type": "select",
      "id": "main_ground",
      "label": "Background while loading",
      "options": [
        { "value": "ink", "label": "Ink" },
        { "value": "blue", "label": "Blue" },
        { "value": "red", "label": "Red" },
        { "value": "grey", "label": "Grey" }
      ],
      "default": "ink"
    },
    { "type": "header", "content": "Headline and button" },
    { "type": "text", "id": "headline", "label": "Headline", "default": "Independent publisher and risograph printer." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop editions" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select",
      "id": "spacing",
      "label": "Top spacing",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "none"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
