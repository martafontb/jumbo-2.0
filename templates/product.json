    },
    "pairs": {
      "type": "product-pairs",
      "settings": { "limit": 3, "label": "Pairs well with", "caption": "Add to the same parcel", "heading": "Complete the set", "spacing": "large" }
    },
    "reviews": {
      "type": "product-reviews",
      "blocks": {},
      "block_order": [],
      "settings": { "label": "Reviews", "spacing": "large" }
    }
  },
  "order": ["main", "artist", "related", "pairs", "reviews"]
}
