{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "breadcrumb": { "type": "breadcrumb", "settings": {} },
        "title": { "type": "title", "settings": { "accent": true, "accent_color": "blue" } },
        "artist": { "type": "artist", "settings": { "vendor_fallback": false } },
        "price": { "type": "price", "settings": { "show_edition": true, "show_in_stock": true, "show_tax_note": false } },
        "specs": { "type": "specs", "settings": {} },
        "variant_picker": { "type": "variant_picker", "settings": {} },
        "buy_buttons": { "type": "buy_buttons", "settings": { "show_quantity": false, "show_total": false, "show_dynamic_checkout": false, "show_view_cart": true } },
        "guide_link": { "type": "guide_link", "settings": { "label": "Size & shipping guide →" } },
        "description": { "type": "description", "settings": {} }
      },
      "block_order": ["breadcrumb", "title", "artist", "price", "specs", "variant_picker", "buy_buttons", "guide_link", "description"],
      "settings": { "gallery_layout": "stack", "gallery_ground": "blue", "captions": true, "sticky_info": true, "guide_enabled": true }
    },
    "artist": {
      "type": "artist-block",
      "settings": { "label": "The artist", "spacing": "large" }
