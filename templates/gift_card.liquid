{% layout none %}
{%- comment -%}
  Gift card page. Shopify requires this template to be Liquid, not JSON.
{%- endcomment -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-scripts' -%}
    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main id="MainContent" class="main page gift-card">
      <p class="pill pill--blue">{{ 'gift_card.title' | t }}</p>
      <h1 class="title-page">{{ gift_card.balance | money }}</h1>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="form-message form-message--error">{{ 'gift_card.expired' | t }}</p>
      {%- elsif gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
        <p class="label">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <div class="gift-card__code">
        <p class="label">{{ 'gift_card.use_at_checkout' | t }}</p>
        <p class="title-statement" id="GiftCardCode">{{ gift_card.code | format_code }}</p>
      </div>

      <div class="gift-card__actions">
        <a class="button" href="{{ shop.url }}">{{ shop.name | escape }} →</a>
        <button type="button" class="button button--secondary" data-print>{{ 'gift_card.print' | t }}</button>
        {%- if gift_card.pass_url -%}
          <a href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="120"
              height="40"
              loading="lazy"
            >
          </a>
        {%- endif -%}
      </div>
    </main>

    <script type="module">
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>

    <style>
      .gift-card { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-block: 40px; }
      .gift-card__code { padding-top: 12px; border-top: var(--border); width: 100%; }
      .gift-card__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
      @media print { .gift-card__actions { display: none; } }
    </style>
  </body>
</html>
